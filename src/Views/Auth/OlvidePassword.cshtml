@{
    ViewData["Title"] = "Recuperar Contraseña";
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - PresupuestoFamiliarApp</title>
    
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        primary: {
                            50: '#f0f9ff',
                            100: '#e0f2fe',
                            200: '#bae6fd',
                            300: '#7dd3fc',
                            400: '#38bdf8',
                            500: '#0ea5e9',
                            600: '#0284c7',
                            700: '#0369a1',
                            800: '#075985',
                            900: '#0c4a6e',
                        }
                    }
                }
            }
        }
    </script>
    
    <link href="~/font-awesome/css/font-awesome.css" rel="stylesheet" />
    
    <style>
        body {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
        }
    </style>
</head>
<body class="flex items-center justify-center min-h-screen p-4">
    <!-- Animated Background -->
    <div class="fixed inset-0 overflow-hidden pointer-events-none">
        <div class="absolute -top-40 -right-40 w-80 h-80 bg-purple-300 rounded-full mix-blend-multiply filter blur-xl opacity-70 animate-blob"></div>
        <div class="absolute -bottom-40 -left-40 w-80 h-80 bg-yellow-300 rounded-full mix-blend-multiply filter blur-xl opacity-70 animate-blob animation-delay-2000"></div>
        <div class="absolute top-40 left-40 w-80 h-80 bg-pink-300 rounded-full mix-blend-multiply filter blur-xl opacity-70 animate-blob animation-delay-4000"></div>
    </div>

    <style>
        @@keyframes blob {
            0%, 100% { transform: translate(0, 0) scale(1); }
            33% { transform: translate(30px, -50px) scale(1.1); }
            66% { transform: translate(-20px, 20px) scale(0.9); }
        }
        .animate-blob {
            animation: blob 7s infinite;
        }
        .animation-delay-2000 {
            animation-delay: 2s;
        }
        .animation-delay-4000 {
            animation-delay: 4s;
        }
    </style>

    <div class="w-full max-w-md relative z-10">
        <!-- Logo/Brand -->
        <div class="text-center mb-8">
            <div class="inline-flex items-center justify-center w-20 h-20 bg-white rounded-full shadow-lg mb-4">
                <span class="text-4xl">🔐</span>
            </div>
            <h1 class="text-4xl font-bold text-white mb-2">Recuperar Contraseña</h1>
            <p class="text-purple-100">Te ayudaremos a recuperar el acceso</p>
        </div>

        <!-- Card -->
        <div class="bg-white/95 backdrop-blur-xl rounded-2xl shadow-2xl p-8 border border-white/20">
            <!-- Success/Error Messages -->
            @if (TempData["Exito"] != null)
            {
                <div class="mb-6 p-4 bg-green-50 border-l-4 border-green-500 rounded-lg">
                    <div class="flex items-center gap-2 text-green-700">
                        <i class="fa fa-check-circle text-xl"></i>
                        <span class="font-semibold">@TempData["Exito"]</span>
                    </div>
                </div>
            }

            @if (TempData["Error"] != null)
            {
                <div class="mb-6 p-4 bg-red-50 border-l-4 border-red-500 rounded-lg">
                    <div class="flex items-center gap-2 text-red-700">
                        <i class="fa fa-exclamation-circle text-xl"></i>
                        <span class="font-semibold">@TempData["Error"]</span>
                    </div>
                </div>
            }

            <!-- Info Message -->
            <div class="mb-6 p-4 bg-blue-50 border border-blue-200 rounded-xl">
                <p class="text-blue-800 text-sm">
                    <i class="fa fa-info-circle mr-2"></i>
                    Ingresa tu correo electrónico y te enviaremos un enlace para restablecer tu contraseña.
                </p>
            </div>

            <form asp-action="OlvidePassword" method="post" class="space-y-6">
                @Html.AntiForgeryToken()

                <!-- Email Input -->
                <div>
                    <label class="block text-sm font-semibold text-slate-700 mb-2">
                        <i class="fa fa-envelope mr-2 text-primary-500"></i>Correo Electrónico
                    </label>
                    <input type="email" 
                           name="email" 
                           class="w-full px-4 py-3.5 border-2 border-slate-200 rounded-xl focus:border-primary-500 focus:ring-4 focus:ring-primary-100 transition outline-none text-slate-700 bg-slate-50" 
                           placeholder="ejemplo@correo.com" 
                           required 
                           autofocus />
                </div>

                <!-- Submit Button -->
                <button type="submit" 
                        class="w-full py-3.5 bg-gradient-to-r from-primary-500 to-blue-600 text-white font-bold rounded-xl hover:from-primary-600 hover:to-blue-700 transform hover:scale-[1.02] transition shadow-lg hover:shadow-xl">
                    <i class="fa fa-paper-plane mr-2"></i>Enviar Enlace de Recuperación
                </button>

                <!-- Back to Login -->
                <div class="text-center pt-4 border-t border-slate-200">
                    <a asp-action="Login" class="text-slate-600 hover:text-primary-600 font-semibold transition inline-flex items-center gap-2">
                        <i class="fa fa-arrow-left"></i>
                        Volver al inicio de sesión
                    </a>
                </div>
            </form>
        </div>

        <!-- Footer -->
        <div class="mt-8 text-center text-white/80 text-sm">
            <p>&copy; 2026 PresupuestoFamiliarApp. Todos los derechos reservados.</p>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
</body>
</html>