@model CategoriaGasto

@{
    ViewData["Title"] = "Editar Presupuesto";
}

<!-- Header -->
<div class="mb-6">
    <h2 class="text-3xl font-bold text-slate-800 dark:text-white mb-2">
        Editar Presupuesto: <span class="text-primary-600 dark:text-primary-400">@Model.Nombre</span>
    </h2>
    <p class="text-slate-600 dark:text-slate-400">Actualiza los detalles y límites de tu categoría de gastos</p>
</div>

<div class="max-w-2xl">
    <div class="bg-white dark:bg-slate-800 rounded-xl shadow-lg border border-slate-200 dark:border-slate-700 p-6 lg:p-8">
        <form asp-action="Edit" class="space-y-6">
            <input type="hidden" asp-for="Id" />
            
            <!-- Validation Summary -->
            <div asp-validation-summary="ModelOnly" class="bg-red-50 dark:bg-red-900/20 border-l-4 border-red-500 rounded-lg p-4" role="alert">
                <div class="flex items-center gap-2 text-red-700 dark:text-red-400">
                    <i class="fa fa-exclamation-circle"></i>
                    <span class="font-semibold">Por favor corrige los siguientes errores:</span>
                </div>
            </div>

            <!-- Nombre -->
            <div>
                <label asp-for="Nombre" class="block text-sm font-semibold text-slate-700 dark:text-slate-300 mb-2">
                    <i class="fa fa-tag mr-2 text-primary-500"></i>Nombre de la Categoría
                </label>
                <input asp-for="Nombre" 
                       class="w-full px-4 py-3 border-2 border-slate-200 dark:border-slate-600 rounded-xl bg-white dark:bg-slate-700 text-slate-800 dark:text-slate-200 focus:border-primary-500 focus:ring-4 focus:ring-primary-100 transition outline-none" 
                       placeholder="Ej. Educación, Salud, Entretenimiento..." />
                <span asp-validation-for="Nombre" class="text-red-600 text-sm mt-1"></span>
            </div>

            <!-- Subcategorías -->
            <div>
                <label asp-for="Subcategoria" class="block text-sm font-semibold text-slate-700 dark:text-slate-300 mb-2">
                    <i class="fa fa-tags mr-2 text-primary-500"></i>Subcategorías incluidas
                </label>
                <input asp-for="Subcategoria" 
                       class="w-full px-4 py-3 border-2 border-slate-200 dark:border-slate-600 rounded-xl bg-white dark:bg-slate-700 text-slate-800 dark:text-slate-200 focus:border-primary-500 focus:ring-4 focus:ring-primary-100 transition outline-none" 
                       placeholder="Ej. Agua, Luz, Gas, Internet..." />
                <p class="text-xs text-slate-500 dark:text-slate-400 mt-1 flex items-center gap-1">
                    <i class="fa fa-info-circle"></i>
                    Lista los tipos de gastos que incluye esta categoría
                </p>
            </div>

            <!-- Presupuesto Mensual -->
            <div>
                <label asp-for="PresupuestoMensual" class="block text-sm font-semibold text-slate-700 dark:text-slate-300 mb-2">
                    <i class="fa fa-dollar-sign mr-2 text-primary-500"></i>Presupuesto Mensual Asignado
                </label>
                <div class="flex items-center gap-2">
                    <span class="px-4 py-3 bg-slate-100 dark:bg-slate-700 text-slate-700 dark:text-slate-300 font-bold rounded-lg border-2 border-slate-200 dark:border-slate-600">
                        @ViewBag.SimboloMoneda
                    </span>
                    <input asp-for="PresupuestoMensual" 
                           type="number" 
                           step="0.01" 
                           class="flex-1 px-4 py-3 border-2 border-slate-200 dark:border-slate-600 rounded-xl bg-white dark:bg-slate-700 text-slate-800 dark:text-slate-200 text-2xl font-bold focus:border-primary-500 focus:ring-4 focus:ring-primary-100 transition outline-none" 
                           placeholder="0.00"
                           required />
                </div>
                <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">
                    Define cuánto planeas gastar mensualmente en esta categoría
                </p>
                <span asp-validation-for="PresupuestoMensual" class="text-red-600 text-sm mt-1"></span>
            </div>

            <!-- Submit Buttons -->
            <div class="pt-4 border-t border-slate-200 dark:border-slate-700 flex flex-col sm:flex-row gap-3">
                <button type="submit" 
                        class="flex-1 py-3.5 bg-gradient-to-r from-primary-500 to-blue-600 text-white font-bold rounded-xl hover:from-primary-600 hover:to-blue-700 transform hover:scale-[1.02] transition shadow-lg hover:shadow-xl flex items-center justify-center gap-2">
                    <i class="fa fa-save"></i>
                    Guardar Cambios
                </button>
                <a asp-action="Index" 
                   class="flex-1 sm:flex-initial px-6 py-3.5 bg-slate-200 dark:bg-slate-700 text-slate-700 dark:text-slate-300 font-semibold rounded-xl hover:bg-slate-300 dark:hover:bg-slate-600 transition text-center flex items-center justify-center gap-2">
                    <i class="fa fa-times"></i>
                    Cancelar
                </a>
            </div>
        </form>
    </div>

    <!-- Info Section -->
    <div class="mt-6 bg-amber-50 dark:bg-amber-900/20 border-l-4 border-amber-500 rounded-lg p-6">
        <div class="flex items-start gap-4">
            <div class="text-3xl">⚠️</div>
            <div class="flex-1">
                <h4 class="text-lg font-bold text-amber-900 dark:text-amber-300 mb-2">Importante al Editar</h4>
                <ul class="list-disc list-inside text-amber-800 dark:text-amber-200 text-sm space-y-1">
                    <li>Los cambios afectarán solo los futuros cálculos de presupuesto</li>
                    <li>Las transacciones pasadas mantendrán su categoría original</li>
                    <li>Puedes ajustar el presupuesto mensualmente según tus necesidades</li>
                    <li>No se puede cambiar la moneda de una categoría existente</li>
                </ul>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}