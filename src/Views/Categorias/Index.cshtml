@model IEnumerable<CategoriaGasto>

@{
    ViewData["Title"] = "Mis Presupuestos";
}

<!-- Header Section -->
<div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 mb-6">
    <div>
        <h2 class="text-3xl font-bold text-slate-800 dark:text-white mb-2">Gestión de Presupuestos y Categorías</h2>
        <p class="text-slate-600 dark:text-slate-400">Organiza tus gastos y establece límites mensuales</p>
    </div>
    <a asp-action="Create" 
       class="inline-flex items-center gap-2 px-5 py-3 bg-gradient-to-r from-primary-500 to-blue-600 text-white font-semibold rounded-xl hover:from-primary-600 hover:to-blue-700 transition shadow-lg hover:shadow-xl">
        <span class="text-xl font-bold">+</span> Nueva Categoría
    </a>
</div>

<!-- Summary Stats -->
@{
    var totalPresupuesto = Model.Sum(c => c.PresupuestoMensual);
    var cantidadCategorias = Model.Count();
    var promedioPresupuesto = cantidadCategorias > 0 ? totalPresupuesto / cantidadCategorias : 0;
}

<div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-8">
    <div class="bg-gradient-to-br from-primary-500 to-blue-600 rounded-xl shadow-lg p-6 text-white">
        <div class="flex items-center justify-between mb-2">
            <p class="text-sm font-semibold uppercase tracking-wider text-primary-100">Total Categorías</p>
            <span class="text-3xl">📊</span>
        </div>
        <p class="text-4xl font-bold mb-1">@cantidadCategorias</p>
        <p class="text-primary-100 text-sm">Categorías activas</p>
    </div>
    
    <div class="bg-gradient-to-br from-purple-500 to-pink-600 rounded-xl shadow-lg p-6 text-white">
        <div class="flex items-center justify-between mb-2">
            <p class="text-sm font-semibold uppercase tracking-wider text-purple-100">Presupuesto Total</p>
            <span class="text-3xl">💰</span>
        </div>
        <p class="text-4xl font-bold mb-1">@ViewBag.SimboloMoneda @totalPresupuesto.ToString("N0")</p>
        <p class="text-purple-100 text-sm">Por mes</p>
    </div>
    
    <div class="bg-gradient-to-br from-emerald-500 to-teal-600 rounded-xl shadow-lg p-6 text-white">
        <div class="flex items-center justify-between mb-2">
            <p class="text-sm font-semibold uppercase tracking-wider text-emerald-100">Promedio</p>
            <span class="text-3xl">📈</span>
        </div>
        <p class="text-4xl font-bold mb-1">@ViewBag.SimboloMoneda @promedioPresupuesto.ToString("N0")</p>
        <p class="text-emerald-100 text-sm">Por categoría</p>
    </div>
</div>

<!-- Categories Grid -->
@if (Model.Any())
{
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        @foreach (var item in Model)
        {
            // Color variations for cards
            var cardColors = new[] {
                "from-blue-500 to-cyan-500",
                "from-purple-500 to-pink-500",
                "from-green-500 to-emerald-500",
                "from-orange-500 to-red-500",
                "from-indigo-500 to-purple-500",
                "from-pink-500 to-rose-500"
            };
            var colorIndex = Math.Abs(item.Id.GetHashCode()) % cardColors.Length;
            var gradientColor = cardColors[colorIndex];
            
            <div class="bg-white dark:bg-slate-800 rounded-xl shadow-lg border border-slate-200 dark:border-slate-700 overflow-hidden hover:shadow-2xl transition-all hover:-translate-y-1">
                <!-- Card Header with Gradient -->
                <div class="bg-gradient-to-r @gradientColor p-6 text-white">
                    <div class="flex items-start justify-between mb-2">
                        <div class="flex-1">
                            <h3 class="text-xl font-bold mb-1">@item.Nombre</h3>
                            @if (!string.IsNullOrEmpty(item.Subcategoria))
                            {
                                <p class="text-sm opacity-90">@item.Subcategoria</p>
                            }
                            else
                            {
                                <p class="text-sm opacity-75 italic">Sin subcategorías</p>
                            }
                        </div>
                        <div class="text-4xl opacity-80">🏷️</div>
                    </div>
                </div>
                
                <!-- Card Body -->
                <div class="p-6">
                    <div class="mb-6">
                        <p class="text-sm text-slate-600 dark:text-slate-400 mb-2 font-medium">Presupuesto Mensual</p>
                        <p class="text-4xl font-bold bg-gradient-to-r @gradientColor bg-clip-text text-transparent">
                            @ViewBag.SimboloMoneda @item.PresupuestoMensual.ToString("N2")
                        </p>
                    </div>
                    
                    <!-- Action Buttons -->
                    <div class="space-y-2">
                        <a asp-action="Edit" asp-route-id="@item.Id" 
                           class="block w-full text-center px-4 py-3 bg-gradient-to-r @gradientColor text-white font-semibold rounded-lg hover:opacity-90 transition shadow-md">
                            📝Editar Presupuesto
                        </a>
                        <a asp-action="Delete" asp-route-id="@item.Id" 
                           class="block w-full text-center px-4 py-2.5 bg-red-100 dark:bg-red-900/30 text-red-700 dark:text-red-300 font-semibold rounded-lg hover:bg-red-200 dark:hover:bg-red-900/50 transition">
                            🗑Eliminar Categoría
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <!-- Empty State -->
    <div class="bg-slate-100 dark:bg-slate-800 rounded-xl p-12 text-center">
        <div class="text-6xl mb-4">📊</div>
        <h3 class="text-2xl font-bold text-slate-800 dark:text-white mb-2">No hay categorías registradas</h3>
        <p class="text-slate-600 dark:text-slate-400 mb-6">Crea categorías para organizar tus gastos y establecer presupuestos mensuales</p>
        <a asp-action="Create" 
           class="inline-flex items-center gap-2 px-6 py-3 bg-gradient-to-r from-primary-500 to-blue-600 text-white font-semibold rounded-xl hover:from-primary-600 hover:to-blue-700 transition shadow-lg">
            <span class="text-xl font-bold">+</span> Crear Primera Categoría
        </a>
    </div>
}

<!-- Help Section -->
<div class="mt-8 bg-blue-50 dark:bg-blue-900/20 border-l-4 border-blue-500 rounded-lg p-6">
    <div class="flex items-start gap-4">
        <div class="text-3xl">💡</div>
        <div class="flex-1">
            <h4 class="text-lg font-bold text-blue-900 dark:text-blue-300 mb-2">Consejo sobre Presupuestos</h4>
            <p class="text-blue-800 dark:text-blue-200 text-sm mb-2">
                Las categorías te ayudan a organizar tus gastos y mantener el control de tu dinero. 
                Establece límites realistas para cada categoría basados en tus ingresos y necesidades.
            </p>
            <ul class="list-disc list-inside text-blue-800 dark:text-blue-200 text-sm space-y-1">
                <li>Define categorías claras y específicas</li>
                <li>Revisa y ajusta tus presupuestos mensualmente</li>
                <li>Usa subcategorías para un mejor detalle</li>
                <li>Deja un margen para gastos imprevistos</li>
            </ul>
        </div>
    </div>
</div>