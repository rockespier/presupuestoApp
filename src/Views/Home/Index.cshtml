                    onDestroyStarted: () => {
                        if (!tourObj.hasNextStep() || confirm("¿Seguro que quieres saltar el tutorial?")) {
                            fetch('/Home/MarcarTourCompletado', { method: 'POST' });
                            tourObj.destroy();
