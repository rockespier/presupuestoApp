@model PresupuestoFamiliarApp.Models.Transaccion

<h2>Editar Movimiento</h2>
<hr />
<form asp-action="Edit" class="card p-4 shadow-sm bg-light mb-5">
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="EsTransferencia" />

    <div class="row">
        <div class="col-md-6 form-group mb-3">
            <label asp-for="Fecha" class="control-label fw-bold">Fecha del Movimiento</label>
            <input asp-for="Fecha" type="date" class="form-control" required />
        </div>
        <div class="col-md-6 form-group mb-3">
            <label asp-for="Tipo" class="control-label fw-bold">Tipo</label>
            <select asp-for="Tipo" class="form-select" id="tipoSelect" asp-items="Html.GetEnumSelectList<TipoTransaccion>()"></select>
        </div>
    </div>

    <div class="form-group mb-3 row">
        <div class="col-md-7">
            <label asp-for="Monto" class="control-label fw-bold">Monto Original</label>
            <input asp-for="Monto" type="number" step="0.01" class="form-control text-primary fw-bold" required />
        </div>
        <div class="col-md-5">
            <label asp-for="MonedaTransaccion" class="control-label fw-bold">Moneda</label>
            <select asp-for="MonedaTransaccion" class="form-select bg-white" asp-items="Html.GetEnumSelectList<Moneda>()"></select>
        </div>
    </div>

    <div class="form-group mb-3">
        <label asp-for="Descripcion" class="control-label fw-bold">Descripción</label>
        <input asp-for="Descripcion" class="form-control" required />
    </div>

    <div class="form-group mb-3">
        <label asp-for="CuentaId" class="control-label fw-bold">Cuenta</label>
        <select asp-for="CuentaId" class="form-select" asp-items="ViewBag.CuentaId" required></select>
    </div>

    <div class="form-group mb-4" id="divCategoria">
        <label asp-for="CategoriaGastoId" class="control-label fw-bold">Categoría (Solo para gastos)</label>
        <select asp-for="CategoriaGastoId" class="form-select" asp-items="ViewBag.CategoriaGastoId">
            <option value="">-- Sin categoría --</option>
        </select>
    </div>

    <div class="form-group mt-3">
        <button type="submit" class="btn btn-warning fw-bold text-dark px-4">Actualizar y Recalcular</button>
        <a asp-action="Index" class="btn btn-secondary px-4 ms-2">Cancelar</a>
    </div>
</form>

@section Scripts {
    <script>
        function evaluarMostrarCategoria() {
            var tipoSeleccionado = document.getElementById('tipoSelect').value;
            var divCategoria = document.getElementById('divCategoria');

            if (tipoSeleccionado === '1' || tipoSeleccionado === 'Ingreso') { // Ajusta según el valor numérico/texto de tu Enum
                divCategoria.style.display = 'none';
            } else {
                divCategoria.style.display = 'block';
            }
        }
        document.getElementById('tipoSelect').addEventListener('change', evaluarMostrarCategoria);
        evaluarMostrarCategoria();
    </script>
}