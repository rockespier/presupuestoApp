@model PresupuestoFamiliarApp.Models.Deudor

@{
    ViewData["Title"] = "Detalle del Deudor";
    var simboloMoneda = ViewBag.SimboloMoneda ?? "S/";
    var deudaTotal = Model.CuentasPorCobrar?.Sum(c => c.MontoTotal - c.MontoPagado) ?? 0;
}

<!-- Header -->
<div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 mb-6">
    <div>
        <h2 class="text-3xl font-bold text-slate-800 dark:text-white mb-2">
            Historial de: <span class="text-primary-600 dark:text-primary-400">@Model.Nombre</span>
        </h2>
        <p class="text-slate-600 dark:text-slate-400">Todas las deudas y pagos registrados</p>
    </div>
    <div class="flex gap-2">
        <a asp-action="Index" 
           class="px-4 py-2.5 bg-slate-200 dark:bg-slate-700 text-slate-700 dark:text-slate-300 font-semibold rounded-lg hover:bg-slate-300 dark:hover:bg-slate-600 transition flex items-center gap-2">
            <i class="fa fa-arrow-left"></i>
            Volver
        </a>
        <a asp-action="NuevaDeuda" asp-route-deudorId="@Model.Id" 
           class="px-4 py-2.5 bg-gradient-to-r from-red-500 to-rose-600 text-white font-semibold rounded-lg hover:from-red-600 hover:to-rose-700 transition shadow-lg flex items-center gap-2">
            <span class="text-xl font-bold">+</span>
            Cargar Deuda
        </a>
    </div>
</div>

<!-- Summary Card -->
<div class="bg-gradient-to-br from-red-500 to-rose-600 rounded-xl shadow-lg p-6 mb-6 text-white">
    <div class="flex items-center justify-between">
        <div>
            <p class="text-red-100 text-sm font-semibold uppercase tracking-wider mb-1">Deuda Total Pendiente</p>
            <p class="text-5xl font-bold">@simboloMoneda @deudaTotal.ToString("N2")</p>
        </div>
        <div class="text-6xl opacity-60">💸</div>
    </div>
</div>

<!-- Debts Table -->
@if (Model.CuentasPorCobrar == null || !Model.CuentasPorCobrar.Any())
{
    <div class="bg-slate-100 dark:bg-slate-800 rounded-xl p-12 text-center">
        <div class="text-6xl mb-4">📋</div>
        <h3 class="text-2xl font-bold text-slate-800 dark:text-white mb-2">No hay deudas registradas</h3>
        <p class="text-slate-600 dark:text-slate-400 mb-6">Comienza a registrar las deudas de este cliente</p>
        <a asp-action="NuevaDeuda" asp-route-deudorId="@Model.Id" 
           class="inline-flex items-center gap-2 px-6 py-3 bg-gradient-to-r from-red-500 to-rose-600 text-white font-semibold rounded-xl hover:from-red-600 hover:to-rose-700 transition shadow-lg">
            <span class="text-xl font-bold">+</span>
            Cargar Primera Deuda
        </a>
    </div>
}
else
{
    <div class="bg-white dark:bg-slate-800 rounded-xl shadow-lg border border-slate-200 dark:border-slate-700 overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full">
                <thead class="bg-slate-800 dark:bg-slate-900 text-white">
                    <tr>
                        <th class="px-4 py-3 text-left text-sm font-semibold">Concepto</th>
                        <th class="px-4 py-3 text-left text-sm font-semibold">Vencimiento</th>
                        <th class="px-4 py-3 text-right text-sm font-semibold">Monto Total</th>
                        <th class="px-4 py-3 text-right text-sm font-semibold">Pagado</th>
                        <th class="px-4 py-3 text-center text-sm font-semibold">Estado</th>
                        <th class="px-4 py-3 text-center text-sm font-semibold">Acción</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-200 dark:divide-slate-700">
                    @foreach (var cuenta in Model.CuentasPorCobrar.OrderBy(c => c.FechaVencimiento))
                    {
                        var pendiente = cuenta.MontoTotal - cuenta.MontoPagado;
                        var estaVencido = cuenta.FechaVencimiento < DateTime.Now && !cuenta.EstaPagado;
                        
                        <tr class="hover:bg-slate-50 dark:hover:bg-slate-700/50 transition">
                            <td class="px-4 py-4">
                                <div class="flex items-center gap-3">
                                    <div class="w-10 h-10 rounded-full bg-gradient-to-br @(cuenta.EstaPagado ? "from-green-400 to-emerald-500" : "from-red-400 to-rose-500") flex items-center justify-center text-white font-bold">
                                        @(cuenta.EstaPagado ? "✓" : "!")
                                    </div>
                                    <div>
                                        <p class="font-bold text-slate-800 dark:text-white">@cuenta.Concepto</p>
                                        @if (cuenta.EsAlquiler)
                                        {
                                            <span class="inline-flex px-2 py-0.5 text-xs font-semibold rounded-full bg-purple-100 dark:bg-purple-900/30 text-purple-700 dark:text-purple-300">
                                                <i class="fa fa-home mr-1"></i>Alquiler
                                            </span>
                                        }
                                    </div>
                                </div>
                            </td>
                            <td class="px-4 py-4">
                                <div class="flex items-center gap-2">
                                    <i class="fa fa-calendar text-slate-400"></i>
                                    <span class="@(estaVencido ? "text-red-600 dark:text-red-400 font-bold" : "text-slate-700 dark:text-slate-300")">
                                        @cuenta.FechaVencimiento.ToString("dd/MM/yyyy")
                                    </span>
                                </div>
                                @if (estaVencido)
                                {
                                    <span class="text-xs text-red-600 dark:text-red-400 font-semibold">¡Vencido!</span>
                                }
                            </td>
                            <td class="px-4 py-4 text-right">
                                <p class="text-lg font-bold text-slate-800 dark:text-white">
                                    @simboloMoneda @cuenta.MontoTotal.ToString("N2")
                                </p>
                            </td>
                            <td class="px-4 py-4 text-right">
                                <p class="text-lg font-bold text-green-600 dark:text-green-400">
                                    @simboloMoneda @cuenta.MontoPagado.ToString("N2")
                                </p>
                            </td>
                            <td class="px-4 py-4 text-center">
                                @if (cuenta.EstaPagado)
                                {
                                    <span class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-semibold rounded-full bg-green-100 dark:bg-green-900/30 text-green-700 dark:text-green-300">
                                        <span class="w-2 h-2 bg-green-500 rounded-full"></span>
                                        Pagado
                                    </span>
                                }
                                else
                                {
                                    <span class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-semibold rounded-full bg-amber-100 dark:bg-amber-900/30 text-amber-700 dark:text-amber-300">
                                        <span class="w-2 h-2 bg-amber-500 rounded-full animate-pulse"></span>
                                        Pendiente @simboloMoneda @pendiente.ToString("N2")
                                    </span>
                                }
                            </td>
                            <td class="px-4 py-4">
                                <div class="flex items-center justify-center gap-2">
                                    @if (!cuenta.EstaPagado)
                                    {
                                        <a asp-action="RegistrarPago" asp-route-id="@cuenta.Id" 
                                           class="px-3 py-1.5 text-xs font-semibold bg-green-100 dark:bg-green-900/30 text-green-700 dark:text-green-300 rounded-lg hover:bg-green-200 dark:hover:bg-green-900/50 transition flex items-center gap-1">
                                            <i class="fa fa-money"></i>
                                            Cobrar
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="px-3 py-1.5 text-xs font-semibold bg-slate-100 dark:bg-slate-700 text-slate-500 dark:text-slate-400 rounded-lg flex items-center gap-1">
                                            <i class="fa fa-check"></i>
                                            Completado
                                        </span>
                                    }
                                    
                                    @if (cuenta.MontoPagado == 0)
                                    {
                                        <form asp-action="EliminarDeuda" method="post" class="inline" 
                                              onsubmit="return confirm('¿Estás seguro de eliminar este cargo?');">
                                            <input type="hidden" name="id" value="@cuenta.Id" />
                                            <input type="hidden" name="deudorId" value="@Model.Id" />
                                            <button type="submit" 
                                                    class="px-3 py-1.5 text-xs font-semibold bg-red-100 dark:bg-red-900/30 text-red-700 dark:text-red-300 rounded-lg hover:bg-red-200 dark:hover:bg-red-900/50 transition">
                                                <i class="fa fa-trash"></i>
                                            </button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}