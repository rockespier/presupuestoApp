@model IEnumerable<PresupuestoFamiliarApp.Models.MovimientoFijo>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Ingresos y Gastos Fijos (Automáticos)</h2>
    <a asp-action="Create" class="btn btn-primary">+ Nuevo Registro Fijo</a>
</div>

<table class="table table-hover shadow-sm bg-white rounded">
    <thead class="table-dark">
        <tr>
            <th>Descripción</th>
            <th>Tipo</th>
            <th>Monto</th>
            <th>Día de Cobro</th>
            <th>Cuenta Automática</th>
            <th>Estado</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td class="fw-bold">@item.Descripcion</td>
                <td>
                    <span class="badge @(item.Tipo == TipoTransaccion.Ingreso ? "bg-success" : "bg-danger")">@item.Tipo</span>
                </td>
                <td class="fw-bold">@ViewBag.SimboloMoneda @item.Monto.ToString("N2")</td>
                <td>Los días <strong>@item.DiaDelMes</strong></td>
                <td>@item.Cuenta?.Nombre</td>
                <td>
                    @if (item.Activo)
                    {
                        <span class="badge bg-primary">Activo</span>
                    }
                    else
                    {

                        <span class="badge bg-secondary">Pausado</span>
                    }
                </td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Editar</a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger" onclick="return confirm('¿Seguro que deseas eliminar esta suscripción automática?');">Eliminar</a>
                </td>
            </tr>
        }
    </tbody>
</table>