@model IEnumerable<Transaccion>

@{
    ViewData["Title"] = "Historial de Movimientos";
}

<!-- Header Section -->
<div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 mb-6">
    <h2 class="text-3xl font-bold text-slate-800 dark:text-white">Historial de Movimientos</h2>
    <div class="flex flex-wrap gap-2">
        <a asp-action="DescargarPlantilla" 
           class="inline-flex items-center gap-2 px-4 py-2 bg-green-100 dark:bg-green-900/30 text-green-700 dark:text-green-300 font-semibold rounded-lg hover:bg-green-200 dark:hover:bg-green-900/50 transition">
            📥 Descargar Plantilla
        </a>
        <form asp-action="ImportarExcel" enctype="multipart/form-data" method="post" class="inline-block">
            <input type="file" name="archivoExcel" id="archivoExcel" accept=".xlsx" class="hidden" onchange="this.form.submit()" />
            <button type="button" onclick="document.getElementById('archivoExcel').click()" 
                    class="inline-flex items-center gap-2 px-4 py-2 bg-green-600 text-white font-semibold rounded-lg hover:bg-green-700 transition shadow-md">
                📤 Importar Datos
            </button>
        </form>
        <a asp-action="Create" 
           class="inline-flex items-center gap-2 px-4 py-2 bg-gradient-to-r from-primary-500 to-blue-600 text-white font-semibold rounded-lg hover:from-primary-600 hover:to-blue-700 transition shadow-md">
            <span class="text-xl font-bold">+</span> Nuevo Movimiento
        </a>
    </div>
</div>

<!-- Filters Card -->
<form method="get" asp-action="Index" class="bg-white dark:bg-slate-800 rounded-xl shadow-lg border border-slate-200 dark:border-slate-700 p-6 mb-6">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-6 gap-4">
        <div>
            <label class="block text-sm font-semibold text-slate-700 dark:text-slate-300 mb-2">Mes</label>
            <select name="mes" class="w-full px-4 py-2 border border-slate-300 dark:border-slate-600 rounded-lg bg-white dark:bg-slate-700 text-slate-800 dark:text-slate-200 focus:ring-2 focus:ring-primary-500 focus:border-transparent">
                <option value="">Todos</option>
                <option value="1" selected="@(ViewBag.MesSeleccionado == 1 ? "selected" : null)">Enero</option>
                <option value="2" selected="@(ViewBag.MesSeleccionado == 2 ? "selected" : null)">Febrero</option>
                <option value="3" selected="@(ViewBag.MesSeleccionado == 3 ? "selected" : null)">Marzo</option>
                <option value="4" selected="@(ViewBag.MesSeleccionado == 4 ? "selected" : null)">Abril</option>
                <option value="5" selected="@(ViewBag.MesSeleccionado == 5 ? "selected" : null)">Mayo</option>
                <option value="6" selected="@(ViewBag.MesSeleccionado == 6 ? "selected" : null)">Junio</option>
                <option value="7" selected="@(ViewBag.MesSeleccionado == 7 ? "selected" : null)">Julio</option>
                <option value="8" selected="@(ViewBag.MesSeleccionado == 8 ? "selected" : null)">Agosto</option>
                <option value="9" selected="@(ViewBag.MesSeleccionado == 9 ? "selected" : null)">Septiembre</option>
                <option value="10" selected="@(ViewBag.MesSeleccionado == 10 ? "selected" : null)">Octubre</option>
                <option value="11" selected="@(ViewBag.MesSeleccionado == 11 ? "selected" : null)">Noviembre</option>
                <option value="12" selected="@(ViewBag.MesSeleccionado == 12 ? "selected" : null)">Diciembre</option>
            </select>
        </div>

        <div>
            <label class="block text-sm font-semibold text-slate-700 dark:text-slate-300 mb-2">Año</label>
            <select name="anio" class="w-full px-4 py-2 border border-slate-300 dark:border-slate-600 rounded-lg bg-white dark:bg-slate-700 text-slate-800 dark:text-slate-200 focus:ring-2 focus:ring-primary-500 focus:border-transparent">
                <option value="">Todos</option>
                @for (int i = DateTime.Now.Year - 3; i <= DateTime.Now.Year + 1; i++)
                {
                    <option value="@i" selected="@(ViewBag.AnioSeleccionado == i ? "selected" : null)">@i</option>
                }
            </select>
        </div>

        <div>
            <label class="block text-sm font-semibold text-slate-700 dark:text-slate-300 mb-2">Tipo</label>
            <select name="tipo" class="w-full px-4 py-2 border border-slate-300 dark:border-slate-600 rounded-lg bg-white dark:bg-slate-700 text-slate-800 dark:text-slate-200 focus:ring-2 focus:ring-primary-500 focus:border-transparent">
                <option value="">Todos</option>
                <option value="Ingreso" selected="@(ViewBag.TipoSeleccionado?.ToString() == "Ingreso" ? "selected" : null)">Ingreso</option>
                <option value="Egreso" selected="@(ViewBag.TipoSeleccionado?.ToString() == "Egreso" ? "selected" : null)">Gasto (Egreso)</option>
            </select>
        </div>

        <div>
            <label class="block text-sm font-semibold text-slate-700 dark:text-slate-300 mb-2">Cuenta</label>
            <select name="cuentaId" class="w-full px-4 py-2 border border-slate-300 dark:border-slate-600 rounded-lg bg-white dark:bg-slate-700 text-slate-800 dark:text-slate-200 focus:ring-2 focus:ring-primary-500 focus:border-transparent" asp-items="ViewBag.Cuentas">
                <option value="">Todas las cuentas</option>
            </select>
        </div>

        <div>
            <label class="block text-sm font-semibold text-slate-700 dark:text-slate-300 mb-2">Categoría</label>
            <select name="categoriaId" class="w-full px-4 py-2 border border-slate-300 dark:border-slate-600 rounded-lg bg-white dark:bg-slate-700 text-slate-800 dark:text-slate-200 focus:ring-2 focus:ring-primary-500 focus:border-transparent" asp-items="ViewBag.Categorias">
                <option value="">Todas las categorías</option>
            </select>
        </div>

        <div class="flex items-end gap-2">
            <button type="submit" class="flex-1 px-4 py-2 bg-primary-600 text-white font-semibold rounded-lg hover:bg-primary-700 transition shadow-md">
                🔍 Filtrar
            </button>
            <a asp-action="Index" class="px-4 py-2 bg-slate-200 dark:bg-slate-700 text-slate-700 dark:text-slate-300 font-semibold rounded-lg hover:bg-slate-300 dark:hover:bg-slate-600 transition" title="Limpiar filtros">
                ✖
            </a>
        </div>
    </div>
</form>

<!-- Summary Cards -->
<div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-6">
    <div class="bg-gradient-to-br from-green-500 to-emerald-600 rounded-xl shadow-lg p-6 text-white">
        <p class="text-sm font-semibold uppercase tracking-wider text-green-100 mb-2">Total Ingresos (Filtrados)</p>
        <p class="text-4xl font-bold">+ @ViewBag.SimboloMoneda @ViewBag.TotalIngresos.ToString("N2")</p>
    </div>
    <div class="bg-gradient-to-br from-red-500 to-rose-600 rounded-xl shadow-lg p-6 text-white">
        <p class="text-sm font-semibold uppercase tracking-wider text-red-100 mb-2">Total Gastos (Filtrados)</p>
        <p class="text-4xl font-bold">- @ViewBag.SimboloMoneda @ViewBag.TotalEgresos.ToString("N2")</p>
    </div>
    <div class="bg-gradient-to-br from-blue-500 to-purple-600 rounded-xl shadow-lg p-6 text-white">
        <p class="text-sm font-semibold uppercase tracking-wider text-blue-100 mb-2">Balance / Neto</p>
        <p class="text-4xl font-bold">@ViewBag.SimboloMoneda @ViewBag.BalanceTotal.ToString("N2")</p>
    </div>
</div>

<!-- Table Controls -->
<div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 mb-4">
    <div class="flex items-center gap-2">
        <label class="text-sm text-slate-600 dark:text-slate-400">Mostrar:</label>
        <select id="tamanioPaginaSelect" class="px-3 py-1.5 border border-slate-300 dark:border-slate-600 rounded-lg bg-white dark:bg-slate-700 text-slate-800 dark:text-slate-200 text-sm focus:ring-2 focus:ring-primary-500" onchange="cambiarTamanioPagina(this.value)">
            <option value="10" selected="@(ViewBag.TamanioPagina == 10 ? "selected" : null)">10</option>
            <option value="25" selected="@(ViewBag.TamanioPagina == 25 ? "selected" : null)">25</option>
            <option value="50" selected="@(ViewBag.TamanioPagina == 50 ? "selected" : null)">50</option>
            <option value="100" selected="@(ViewBag.TamanioPagina == 100 ? "selected" : null)">100</option>
        </select>
        <span class="text-sm text-slate-600 dark:text-slate-400">registros por página</span>
    </div>
    <div class="text-sm text-slate-600 dark:text-slate-400">
        Mostrando @((ViewBag.PaginaActual - 1) * ViewBag.TamanioPagina + 1) - @(Math.Min(ViewBag.PaginaActual * ViewBag.TamanioPagina, Model.Count() + (ViewBag.PaginaActual - 1) * ViewBag.TamanioPagina))
    </div>
</div>

<!-- Table -->
<div class="bg-white dark:bg-slate-800 rounded-xl shadow-lg border border-slate-200 dark:border-slate-700 overflow-hidden">
    <div class="overflow-x-auto">
        <table class="w-full">
            <thead class="bg-slate-800 dark:bg-slate-900 text-white">
                <tr>
                    <th class="px-4 py-3 text-left text-sm font-semibold">
                        <a class="hover:text-primary-300 transition" asp-action="Index"
                           asp-route-sortOrder="@ViewBag.FechaSortParm"
                           asp-route-mes="@ViewBag.MesSeleccionado" asp-route-anio="@ViewBag.AnioSeleccionado"
                           asp-route-tipo="@ViewBag.TipoSeleccionado" asp-route-categoriaId="@ViewBag.CategoriaSeleccionada"
                           asp-route-cuentaId="@ViewBag.CuentaSeleccionada"
                           asp-route-tamanioPagina="@ViewBag.TamanioPagina">
                            Fecha ↕
                        </a>
                    </th>
                    <th class="px-4 py-3 text-left text-sm font-semibold">
                        <a class="hover:text-primary-300 transition" asp-action="Index"
                           asp-route-sortOrder="@ViewBag.TipoSortParm"
                           asp-route-mes="@ViewBag.MesSeleccionado" asp-route-anio="@ViewBag.AnioSeleccionado"
                           asp-route-tipo="@ViewBag.TipoSeleccionado" asp-route-categoriaId="@ViewBag.CategoriaSeleccionada"
                           asp-route-cuentaId="@ViewBag.CuentaSeleccionada"
                           asp-route-tamanioPagina="@ViewBag.TamanioPagina">
                            Tipo ↕
                        </a>
                    </th>
                    <th class="px-4 py-3 text-left text-sm font-semibold">
                        <a class="hover:text-primary-300 transition" asp-action="Index"
                           asp-route-sortOrder="@ViewBag.DescSortParm"
                           asp-route-mes="@ViewBag.MesSeleccionado" asp-route-anio="@ViewBag.AnioSeleccionado"
                           asp-route-tipo="@ViewBag.TipoSeleccionado" asp-route-categoriaId="@ViewBag.CategoriaSeleccionada"
                           asp-route-cuentaId="@ViewBag.CuentaSeleccionada"
                           asp-route-tamanioPagina="@ViewBag.TamanioPagina">
                            Descripción ↕
                        </a>
                    </th>
                    <th class="px-4 py-3 text-left text-sm font-semibold">
                        <a class="hover:text-primary-300 transition" asp-action="Index"
                           asp-route-sortOrder="@ViewBag.CuentaSortParm"
                           asp-route-mes="@ViewBag.MesSeleccionado" asp-route-anio="@ViewBag.AnioSeleccionado"
                           asp-route-tipo="@ViewBag.TipoSeleccionado" asp-route-categoriaId="@ViewBag.CategoriaSeleccionada"
                           asp-route-cuentaId="@ViewBag.CuentaSeleccionada"
                           asp-route-tamanioPagina="@ViewBag.TamanioPagina">
                            Cuenta ↕
                        </a>
                    </th>
                    <th class="px-4 py-3 text-left text-sm font-semibold">
                        <a class="hover:text-primary-300 transition" asp-action="Index"
                           asp-route-sortOrder="@ViewBag.CatSortParm"
                           asp-route-mes="@ViewBag.MesSeleccionado" asp-route-anio="@ViewBag.AnioSeleccionado"
                           asp-route-tipo="@ViewBag.TipoSeleccionado" asp-route-categoriaId="@ViewBag.CategoriaSeleccionada"
                           asp-route-cuentaId="@ViewBag.CuentaSeleccionada"
                           asp-route-tamanioPagina="@ViewBag.TamanioPagina">
                            Categoría ↕
                        </a>
                    </th>
                    <th class="px-4 py-3 text-right text-sm font-semibold">
                        <a class="hover:text-primary-300 transition" asp-action="Index"
                           asp-route-sortOrder="@ViewBag.MontoSortParm"
                           asp-route-mes="@ViewBag.MesSeleccionado" asp-route-anio="@ViewBag.AnioSeleccionado"
                           asp-route-tipo="@ViewBag.TipoSeleccionado" asp-route-categoriaId="@ViewBag.CategoriaSeleccionada"
                           asp-route-cuentaId="@ViewBag.CuentaSeleccionada"
                           asp-route-tamanioPagina="@ViewBag.TamanioPagina">
                            Monto ↕
                        </a>
                    </th>
                    <th class="px-4 py-3 text-center text-sm font-semibold">Acciones</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-slate-200 dark:divide-slate-700">
                @foreach (var item in Model)
                {
                    <tr class="hover:bg-slate-50 dark:hover:bg-slate-700/50 transition">
                        <td class="px-4 py-3 text-sm text-slate-700 dark:text-slate-300">@item.Fecha.ToString("dd/MM/yyyy HH:mm")</td>
                        <td class="px-4 py-3">
                            @if (item.Tipo == TipoTransaccion.Ingreso)
                            {
                                <span class="inline-flex px-3 py-1 text-xs font-semibold rounded-full bg-green-100 dark:bg-green-900/30 text-green-700 dark:text-green-300">Ingreso</span>
                            }
                            else
                            {
                                <span class="inline-flex px-3 py-1 text-xs font-semibold rounded-full bg-red-100 dark:bg-red-900/30 text-red-700 dark:text-red-300">Gasto</span>
                            }
                        </td>
                        <td class="px-4 py-3 text-sm text-slate-700 dark:text-slate-300">@item.Descripcion</td>
                        <td class="px-4 py-3">
                            <span class="inline-flex px-3 py-1 text-xs font-semibold rounded-full bg-blue-100 dark:bg-blue-900/30 text-blue-700 dark:text-blue-300">@item.Cuenta?.Nombre</span>
                        </td>
                        <td class="px-4 py-3 text-sm text-slate-700 dark:text-slate-300">@(item.Categoria?.Nombre ?? "N/A")</td>
                        <td class="px-4 py-3 text-right text-sm font-bold @(item.Tipo == TipoTransaccion.Ingreso ? "text-green-600 dark:text-green-400" : "text-red-600 dark:text-red-400")">
                            @(item.Tipo == TipoTransaccion.Ingreso ? "+" : "-") @ViewBag.SimboloMoneda @item.Monto.ToString("N2")
                        </td>
                        <td class="px-4 py-3 text-center">
                            <div class="flex items-center justify-center gap-2">
                                @if (!item.EsTransferencia)
                                {
                                    <a asp-action="Edit" asp-route-id="@item.Id" 
                                       class="px-3 py-1.5 text-xs font-semibold bg-primary-100 dark:bg-primary-900/30 text-primary-700 dark:text-primary-300 rounded-lg hover:bg-primary-200 dark:hover:bg-primary-900/50 transition">
                                        Editar
                                    </a>
                                }
                                <a asp-action="Delete" asp-route-id="@item.Id" 
                                   class="px-3 py-1.5 text-xs font-semibold bg-red-100 dark:bg-red-900/30 text-red-700 dark:text-red-300 rounded-lg hover:bg-red-200 dark:hover:bg-red-900/50 transition">
                                    Eliminar
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Pagination -->
<nav aria-label="Navegacion historial" class="mt-6">
    <ul class="flex flex-wrap justify-center gap-2">
        @for (int i = 1; i <= ViewBag.TotalPaginas; i++)
        {
            <li>
                <a class="px-4 py-2 rounded-lg font-medium transition @(i == ViewBag.PaginaActual ? "bg-primary-600 text-white shadow-md" : "bg-white dark:bg-slate-800 text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-700 border border-slate-300 dark:border-slate-600")" 
                   asp-action="Index"
                   asp-route-pagina="@i"
                   asp-route-mes="@ViewBag.MesSeleccionado"
                   asp-route-anio="@ViewBag.AnioSeleccionado"
                   asp-route-tipo="@ViewBag.TipoSeleccionado"
                   asp-route-categoriaId="@ViewBag.CategoriaSeleccionada"
                   asp-route-cuentaId="@ViewBag.CuentaSeleccionada"
                   asp-route-sortOrder="@ViewBag.CurrentSort"
                   asp-route-tamanioPagina="@ViewBag.TamanioPagina">@i</a>
            </li>
        }
    </ul>
</nav>

@section Scripts {
    <script>
        function cambiarTamanioPagina(nuevoTamanio) {
            const params = new URLSearchParams(window.location.search);
            params.set('tamanioPagina', nuevoTamanio);
            params.set('pagina', '1');
            window.location.search = params.toString();
        }
    </script>
}