@model Transaccion // Cambia "Transaccion" si tu modelo tiene otro namespace

@{
    ViewData["Title"] = "Registrar Movimiento";
}

<h2>Registrar Ingreso o Gasto</h2>
<hr />

<div class="row">
    <div class="col-md-6">
        <form asp-action="Create">
            <div class="form-group mb-3">
                <label asp-for="Tipo" class="control-label">Tipo de Movimiento</label>
                <select asp-for="Tipo" class="form-select" id="tipoSelect">
                    <option value="Ingreso">Ingreso (+)</option>
                    <option value="Egreso">Gasto (-)</option>
                </select>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Descripcion" class="control-label">Descripción</label>
                <input asp-for="Descripcion" class="form-control" placeholder="Ej. Quincena, Supermercado, Cine..." required />
            </div>

            <div class="form-group mb-3 row">
                <div class="col-md-7">
                    <label asp-for="Monto" class="control-label fw-bold">Monto</label>
                    <input asp-for="Monto" type="number" step="0.01" class="form-control text-primary fw-bold" required />
                </div>
                <div class="col-md-5">
                    <label asp-for="MonedaTransaccion" class="control-label fw-bold">Moneda</label>
                    <select asp-for="MonedaTransaccion" class="form-select bg-light" asp-items="Html.GetEnumSelectList<Moneda>()"></select>
                </div>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Fecha" class="control-label">Fecha del Movimiento</label>
                <input asp-for="Fecha" type="date" class="form-control" value="@DateTime.Now.ToString("yyyy-MM-dd")" required />
            </div>

            <div class="form-group mb-3">
                <label asp-for="CuentaId" class="control-label">¿De qué cuenta?</label>
                <select asp-for="CuentaId" class="form-select" asp-items="ViewBag.CuentaId"></select>
            </div>

           <div class="form-group mb-3" id="divCategoria">
                <label asp-for="CategoriaGastoId" class="control-label">Categoría (Solo para gastos)</label>
                <select asp-for="CategoriaGastoId" class="form-select" asp-items="ViewBag.CategoriaGastoId">
                    <option value="">-- Selecciona una categoría --</option>
                </select>
            </div>

            <div class="form-group mb-4 p-3 bg-light border-start border-info border-4 rounded" id="divCuotas" style="display: none;">
                <label class="control-label fw-bold text-info">💳 Opciones de Pago (Tarjeta de Crédito)</label>
                <select name="numeroCuotas" class="form-select border-info mt-1">
                    <option value="1">1 Cuota (Pago normal este mes)</option>
                    <option value="3">3 Cuotas (Sin intereses)</option>
                    <option value="4">4 Cuotas (Sin intereses)</option>
                    <option value="5">5 Cuotas (Sin intereses)</option>
                </select>
                <small class="text-muted d-block mt-1">Se dividirá el monto en registros mensuales separados.</small>
            </div>

            <div class="form-group mt-4">
                <input type="submit" value="Guardar Movimiento" class="btn btn-primary w-100" />
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        // Obtenemos la lista de IDs que son tarjetas de crédito desde el backend
        var tarjetasIds = @Html.Raw(ViewBag.TarjetasIds ?? "[]");

        function evaluarMostrarCuotas() {
            var tipoSeleccionado = document.getElementById('tipoSelect').value;
            var cuentaSeleccionada = parseInt(document.getElementById('CuentaId').value);
            var divCategoria = document.getElementById('divCategoria');
            var divCuotas = document.getElementById('divCuotas');

            // 1. Ocultar/Mostrar Categoría
            if (tipoSeleccionado === 'Ingreso') {
                divCategoria.style.display = 'none';
            } else {
                divCategoria.style.display = 'block';
            }

            // 2. Ocultar/Mostrar Cuotas (Solo si es Egreso Y es una Tarjeta)
            var esTarjeta = tarjetasIds.includes(cuentaSeleccionada);
            
            if (tipoSeleccionado === 'Egreso' && esTarjeta) {
                divCuotas.style.display = 'block';
            } else {
                divCuotas.style.display = 'none';
                // Reiniciamos a 1 cuota por seguridad si se oculta
                document.getElementsByName('numeroCuotas')[0].value = '1';
            }
        }

        // Asignamos el evento a los dos selectores
        document.getElementById('tipoSelect').addEventListener('change', evaluarMostrarCuotas);
        document.getElementById('CuentaId').addEventListener('change', evaluarMostrarCuotas);

        // Disparar al cargar la página
        evaluarMostrarCuotas();
    </script>
}