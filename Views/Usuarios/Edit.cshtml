@model PresupuestoFamiliarApp.Models.Usuario

@{
    ViewData["Title"] = "Editar Usuario";
}

<!-- Header -->
<div class="mb-6">
    <h2 class="text-3xl font-bold text-slate-800 dark:text-white mb-2">
        Editar Usuario: <span class="text-primary-600 dark:text-primary-400">@Model.NombreUsuario</span>
    </h2>
    <p class="text-slate-600 dark:text-slate-400">Actualiza la información y permisos del usuario</p>
</div>

<div class="max-w-3xl mx-auto">
    <div class="bg-white dark:bg-slate-800 rounded-xl shadow-lg border border-slate-200 dark:border-slate-700 p-6 lg:p-8">
        <form asp-action="Edit" class="space-y-6">
            <input type="hidden" name="id" value="@Model.Id" />

            <!-- Validation Summary -->
            @if (!ViewData.ModelState.IsValid)
            {
                <div class="bg-red-50 dark:bg-red-900/20 border-l-4 border-red-500 rounded-lg p-4">
                    <div class="flex items-center gap-2 text-red-700 dark:text-red-400">
                        <i class="fa fa-exclamation-circle"></i>
                        <span class="font-semibold">Por favor corrige los errores indicados.</span>
                    </div>
                </div>
            }

            <!-- Nombre de Usuario -->
            <div>
                <label class="block text-sm font-semibold text-slate-700 dark:text-slate-300 mb-2">
                    <i class="fa fa-user mr-2 text-primary-500"></i>Nombre de Usuario (Login)
                </label>
                <input type="text" 
                       name="NombreUsuario" 
                       value="@Model.NombreUsuario" 
                       class="w-full px-4 py-3 border-2 border-slate-200 dark:border-slate-600 rounded-xl bg-white dark:bg-slate-700 text-slate-800 dark:text-slate-200 focus:border-primary-500 focus:ring-4 focus:ring-primary-100 transition outline-none" 
                       required />
                @Html.ValidationMessage("NombreUsuario", new { @class = "text-red-600 text-sm mt-1" })
            </div>

            <!-- Contraseña (Opcional) -->
            <div class="bg-amber-50 dark:bg-amber-900/20 border-2 border-amber-200 dark:border-amber-800 rounded-xl p-4">
                <label class="block text-sm font-semibold text-amber-900 dark:text-amber-300 mb-2">
                    <i class="fa fa-key mr-2"></i>Actualizar Contraseña (Opcional)
                </label>
                <input type="password" 
                       name="PasswordPlain" 
                       class="w-full px-4 py-3 border-2 border-amber-200 dark:border-amber-700 rounded-xl bg-white dark:bg-slate-700 text-slate-800 dark:text-slate-200 focus:border-amber-500 focus:ring-4 focus:ring-amber-100 transition outline-none" 
                       placeholder="Escribe una nueva contraseña..." />
                <p class="text-xs text-amber-800 dark:text-amber-200 mt-2">
                    <i class="fa fa-info-circle mr-1"></i>
                    Déjalo en blanco si NO deseas cambiar la contraseña actual
                </p>
            </div>

            <!-- Email -->
            <div>
                <label asp-for="Email" class="block text-sm font-semibold text-slate-700 dark:text-slate-300 mb-2">
                    <i class="fa fa-envelope mr-2 text-primary-500"></i>Correo Electrónico
                </label>
                <input asp-for="Email" 
                       type="email"
                       class="w-full px-4 py-3 border-2 border-slate-200 dark:border-slate-600 rounded-xl bg-white dark:bg-slate-700 text-slate-800 dark:text-slate-200 focus:border-primary-500 focus:ring-4 focus:ring-primary-100 transition outline-none" 
                       required />
                <span asp-validation-for="Email" class="text-red-600 text-sm mt-1"></span>
            </div>

            <!-- Rol -->
            <div>
                <label class="block text-sm font-semibold text-slate-700 dark:text-slate-300 mb-2">
                    <i class="fa fa-shield mr-2 text-primary-500"></i>Rol en el Sistema
                </label>
                <select name="Rol" 
                        class="w-full px-4 py-3 border-2 border-slate-200 dark:border-slate-600 rounded-xl bg-white dark:bg-slate-700 text-slate-800 dark:text-slate-200 focus:border-primary-500 focus:ring-4 focus:ring-primary-100 transition outline-none">
                    @if (Model.Rol == "Usuario")
                    {
                        <option value="Usuario" selected>Usuario Normal (Solo espacios asignados)</option>
                        <option value="Administrador">Administrador (Control Total)</option>
                    }
                    else
                    {
                        <option value="Usuario">Usuario Normal (Solo espacios asignados)</option>
                        <option value="Administrador" selected>Administrador (Control Total)</option>
                    }
                </select>
            </div>

            <!-- Espacios -->
            <div class="bg-slate-50 dark:bg-slate-700/50 border-2 border-slate-200 dark:border-slate-600 rounded-xl p-6">
                <label class="block text-sm font-semibold text-slate-700 dark:text-slate-300 mb-4">
                    <i class="fa fa-home mr-2 text-primary-500"></i>¿A qué Espacios tendrá acceso?
                </label>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
                    @foreach (var espacio in ViewBag.Espacios)
                    {
                        bool estaAsignado = Model.Espacios.Any(e => e.Id == espacio.Id);
                        
                        <label class="flex items-center p-3 bg-white dark:bg-slate-800 border-2 @(estaAsignado ? "border-primary-500 bg-primary-50 dark:bg-primary-900/20" : "border-slate-200 dark:border-slate-700") rounded-lg cursor-pointer hover:border-primary-400 transition">
                            <input class="w-5 h-5 text-primary-600 rounded focus:ring-primary-500" 
                                   type="checkbox" 
                                   name="espaciosSeleccionados" 
                                   value="@espacio.Id" 
                                   id="espacio_@espacio.Id" 
                                   @(estaAsignado ? "checked" : "")>
                            <span class="ml-3 font-semibold text-slate-700 dark:text-slate-200">
                                @espacio.Nombre
                            </span>
                        </label>
                    }
                </div>
                <p class="text-xs text-slate-500 dark:text-slate-400 mt-3">
                    <i class="fa fa-info-circle mr-1"></i>
                    Los Administradores tienen acceso a todos los espacios automáticamente
                </p>
            </div>

            <!-- Submit Buttons -->
            <div class="pt-4 border-t border-slate-200 dark:border-slate-700 flex flex-col sm:flex-row gap-3">
                <button type="submit" 
                        class="flex-1 py-3.5 bg-gradient-to-r from-amber-500 to-orange-600 text-white font-bold rounded-xl hover:from-amber-600 hover:to-orange-700 transform hover:scale-[1.02] transition shadow-lg hover:shadow-xl flex items-center justify-center gap-2">
                    <i class="fa fa-save"></i>
                    Actualizar Usuario
                </button>
                <a asp-action="Index" 
                   class="flex-1 sm:flex-initial px-6 py-3.5 bg-slate-200 dark:bg-slate-700 text-slate-700 dark:text-slate-300 font-semibold rounded-xl hover:bg-slate-300 dark:hover:bg-slate-600 transition text-center flex items-center justify-center gap-2">
                    <i class="fa fa-times"></i>
                    Cancelar
                </a>
            </div>
        </form>
    </div>

    <!-- Info Section -->
    <div class="mt-6 bg-purple-50 dark:bg-purple-900/20 border-l-4 border-purple-500 rounded-lg p-6">
        <div class="flex items-start gap-4">
            <div class="text-3xl">💡</div>
            <div class="flex-1">
                <h4 class="text-lg font-bold text-purple-900 dark:text-purple-300 mb-2">Importante al Editar</h4>
                <ul class="list-disc list-inside text-purple-800 dark:text-purple-200 text-sm space-y-1">
                    <li>Solo actualiza la contraseña si el usuario la olvidó o desea cambiarla</li>
                    <li>Cambiar el rol a Administrador le dará acceso total al sistema</li>
                    <li>Los espacios desmarcados ya no serán accesibles para el usuario</li>
                    <li>El nombre de usuario no debe duplicarse con otros existentes</li>
                </ul>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}