@model Espacio

@{
    ViewData["Title"] = "Crear Nuevo Espacio";
}

<!-- Header -->
<div class="mb-6">
    <h2 class="text-3xl font-bold text-slate-800 dark:text-white mb-2">Crear Nuevo Espacio</h2>
    <p class="text-slate-600 dark:text-slate-400">Configura un nuevo espacio para organizar tus finanzas</p>
</div>

<div class="max-w-2xl mx-auto">
    <div class="bg-white dark:bg-slate-800 rounded-xl shadow-lg border border-slate-200 dark:border-slate-700 p-6 lg:p-8">
        <form asp-action="Create" class="space-y-6">
            <!-- Validation Summary -->
            <div asp-validation-summary="ModelOnly" class="bg-red-50 dark:bg-red-900/20 border-l-4 border-red-500 rounded-lg p-4" role="alert">
                <div class="flex items-center gap-2 text-red-700 dark:text-red-400">
                    <i class="fa fa-exclamation-circle"></i>
                    <span class="font-semibold">Por favor corrige los siguientes errores:</span>
                </div>
            </div>

            <!-- Nombre del Espacio -->
            <div>
                <label asp-for="Nombre" class="block text-sm font-semibold text-slate-700 dark:text-slate-300 mb-2">
                    <i class="fa fa-home mr-2 text-primary-500"></i>Nombre del Espacio
                </label>
                <input asp-for="Nombre" 
                       class="w-full px-4 py-3 border-2 border-slate-200 dark:border-slate-600 rounded-xl bg-white dark:bg-slate-700 text-slate-800 dark:text-slate-200 focus:border-primary-500 focus:ring-4 focus:ring-primary-100 transition outline-none" 
                       placeholder="Ej: Mi Casa, Mi Empresa, Finanzas Personales..." 
                       required />
                <span asp-validation-for="Nombre" class="text-red-600 text-sm mt-1"></span>
            </div>

            <!-- Moneda Principal -->
            <div>
                <label asp-for="MonedaPrincipal" class="block text-sm font-semibold text-slate-700 dark:text-slate-300 mb-3">
                    <i class="fa fa-coins mr-2 text-primary-500"></i>Moneda Principal del Espacio
                </label>
                
                <div class="space-y-3">
                    <!-- Soles Option -->
                    <label class="flex items-center p-4 border-2 border-slate-200 dark:border-slate-700 rounded-xl cursor-pointer hover:border-primary-400 transition">
                        <input type="radio" name="MonedaPrincipal" value="0" 
                               class="w-5 h-5 text-primary-600 focus:ring-primary-500" 
                               checked />
                        <div class="ml-4 flex items-center gap-3 flex-1">
                            <span class="text-3xl">🇵🇪</span>
                            <div>
                                <p class="font-bold text-slate-800 dark:text-white">Soles Peruanos</p>
                                <p class="text-sm text-slate-600 dark:text-slate-400">S/ - PEN</p>
                            </div>
                        </div>
                    </label>
                    
                    <!-- Dólares Option -->
                    <label class="flex items-center p-4 border-2 border-slate-200 dark:border-slate-700 rounded-xl cursor-pointer hover:border-primary-400 transition">
                        <input type="radio" name="MonedaPrincipal" value="1" 
                               class="w-5 h-5 text-primary-600 focus:ring-primary-500" />
                        <div class="ml-4 flex items-center gap-3 flex-1">
                            <span class="text-3xl">💵</span>
                            <div>
                                <p class="font-bold text-slate-800 dark:text-white">Dólares Americanos</p>
                                <p class="text-sm text-slate-600 dark:text-slate-400">$ - USD</p>
                            </div>
                        </div>
                    </label>
                    
                    <!-- Euros Option -->
                    <label class="flex items-center p-4 border-2 border-slate-200 dark:border-slate-700 rounded-xl cursor-pointer hover:border-primary-400 transition">
                        <input type="radio" name="MonedaPrincipal" value="2" 
                               class="w-5 h-5 text-primary-600 focus:ring-primary-500" />
                        <div class="ml-4 flex items-center gap-3 flex-1">
                            <span class="text-3xl">🇪🇺</span>
                            <div>
                                <p class="font-bold text-slate-800 dark:text-white">Euros</p>
                                <p class="text-sm text-slate-600 dark:text-slate-400">€ - EUR</p>
                            </div>
                        </div>
                    </label>
                </div>
                
                <p class="text-xs text-slate-500 dark:text-slate-400 mt-2 flex items-center gap-1">
                    <i class="fa fa-info-circle"></i>
                    Esta será la moneda predeterminada para todos los reportes y resúmenes
                </p>
            </div>

            <!-- Submit Buttons -->
            <div class="pt-4 border-t border-slate-200 dark:border-slate-700 flex flex-col sm:flex-row gap-3">
                <button type="submit" 
                        class="flex-1 py-3.5 bg-gradient-to-r from-green-500 to-emerald-600 text-white font-bold rounded-xl hover:from-green-600 hover:to-emerald-700 transform hover:scale-[1.02] transition shadow-lg hover:shadow-xl flex items-center justify-center gap-2">
                    <i class="fa fa-save"></i>
                    Crear y Seleccionar
                </button>
                <a asp-action="Index" asp-controller="Home" 
                   class="flex-1 sm:flex-initial px-6 py-3.5 bg-slate-200 dark:bg-slate-700 text-slate-700 dark:text-slate-300 font-semibold rounded-xl hover:bg-slate-300 dark:hover:bg-slate-600 transition text-center flex items-center justify-center gap-2">
                    <i class="fa fa-times"></i>
                    Cancelar
                </a>
            </div>
        </form>
    </div>

    <!-- Info Section -->
    <div class="mt-6 bg-blue-50 dark:bg-blue-900/20 border-l-4 border-blue-500 rounded-lg p-6">
        <div class="flex items-start gap-4">
            <div class="text-3xl">💡</div>
            <div class="flex-1">
                <h4 class="text-lg font-bold text-blue-900 dark:text-blue-300 mb-2">¿Qué son los Espacios?</h4>
                <p class="text-blue-800 dark:text-blue-200 text-sm mb-3">
                    Los espacios te permiten separar completamente diferentes áreas de tu vida financiera. 
                    Cada espacio es independiente y tiene su propia configuración.
                </p>
                <ul class="list-disc list-inside text-blue-800 dark:text-blue-200 text-sm space-y-1">
                    <li><strong>Finanzas Personales:</strong> Para tus gastos del día a día</li>
                    <li><strong>Mi Negocio:</strong> Para gestionar las finanzas de tu empresa</li>
                    <li><strong>Hogar Familiar:</strong> Para administrar gastos compartidos</li>
                    <li><strong>Proyecto Específico:</strong> Para un viaje, evento o meta</li>
                </ul>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}