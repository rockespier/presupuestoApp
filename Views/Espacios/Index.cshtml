@model IEnumerable<PresupuestoFamiliarApp.Models.Espacio>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>🏢 Gestión de Espacios (Presupuestos)</h2>
    <a asp-action="Create" class="btn btn-primary fw-bold shadow-sm">+ Nuevo Espacio</a>
</div>

<div class="card shadow-sm border-0">
    <table class="table table-hover mb-0">
        <thead class="table-dark">
            <tr>
                <th>Nombre del Espacio</th>
                <th>Moneda Principal</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td class="fw-bold align-middle">@item.Nombre</td>
                    <td class="align-middle">
                        <span class="badge bg-info text-dark fs-6">@item.MonedaPrincipal</span>
                    </td>
                    <td class="align-middle">
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning fw-bold">Editar</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>