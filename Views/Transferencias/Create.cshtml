@model PresupuestoFamiliarApp.ViewModels.TransferenciaViewModel

@{
    ViewData["Title"] = "Nueva Transferencia";
}

<!-- Header -->
<div class="mb-6">
    <h2 class="text-3xl font-bold text-slate-800 dark:text-white mb-2 flex items-center gap-2">
        <span>🔄</span> Nueva Transferencia
    </h2>
    <p class="text-slate-600 dark:text-slate-400">Mueve dinero entre tus cuentas de forma segura</p>
</div>

<div class="max-w-3xl mx-auto">
    <div class="bg-white dark:bg-slate-800 rounded-xl shadow-lg border border-slate-200 dark:border-slate-700 p-6 lg:p-8">
        <form asp-action="Create" class="space-y-6">
            <!-- Validation Summary -->
            <div asp-validation-summary="ModelOnly" class="bg-red-50 dark:bg-red-900/20 border-l-4 border-red-500 rounded-lg p-4" role="alert">
                <div class="flex items-center gap-2 text-red-700 dark:text-red-400">
                    <i class="fa fa-exclamation-circle"></i>
                    <span class="font-semibold">Por favor corrige los siguientes errores:</span>
                </div>
            </div>

            <!-- Transfer Visual Flow -->
            <div class="bg-gradient-to-r from-blue-50 to-purple-50 dark:from-slate-700 dark:to-slate-600 rounded-xl p-6 mb-6">
                <div class="flex items-center justify-between gap-4">
                    <div class="flex-1 text-center">
                        <div class="text-3xl mb-2">📤</div>
                        <p class="text-sm font-semibold text-slate-600 dark:text-slate-300">Cuenta Origen</p>
                    </div>
                    <div class="text-4xl text-primary-500 animate-pulse">→</div>
                    <div class="flex-1 text-center">
                        <div class="text-3xl mb-2">📥</div>
                        <p class="text-sm font-semibold text-slate-600 dark:text-slate-300">Cuenta Destino</p>
                    </div>
                </div>
            </div>

            <!-- Cuentas Origen y Destino -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                    <label asp-for="CuentaOrigenId" class="block text-sm font-semibold text-slate-700 dark:text-slate-300 mb-2">
                        <i class="fa fa-arrow-circle-left mr-2 text-red-500"></i>De la Cuenta (Origen)
                    </label>
                    <select asp-for="CuentaOrigenId" 
                            class="w-full px-4 py-3 border-2 border-red-200 dark:border-red-700 rounded-xl bg-white dark:bg-slate-700 text-slate-800 dark:text-slate-200 focus:border-red-500 focus:ring-4 focus:ring-red-100 transition outline-none" 
                            asp-items="ViewBag.Cuentas" 
                            required>
                        <option value="">-- Selecciona origen --</option>
                    </select>
                    <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">De donde saldrá el dinero</p>
                    <span asp-validation-for="CuentaOrigenId" class="text-red-600 text-sm mt-1"></span>
                </div>

                <div>
                    <label asp-for="CuentaDestinoId" class="block text-sm font-semibold text-slate-700 dark:text-slate-300 mb-2">
                        <i class="fa fa-arrow-circle-right mr-2 text-green-500"></i>A la Cuenta (Destino)
                    </label>
                    <select asp-for="CuentaDestinoId" 
                            class="w-full px-4 py-3 border-2 border-green-200 dark:border-green-700 rounded-xl bg-white dark:bg-slate-700 text-slate-800 dark:text-slate-200 focus:border-green-500 focus:ring-4 focus:ring-green-100 transition outline-none" 
                            asp-items="ViewBag.Cuentas" 
                            required>
                        <option value="">-- Selecciona destino --</option>
                    </select>
                    <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">A donde llegará el dinero</p>
                    <span asp-validation-for="CuentaDestinoId" class="text-red-600 text-sm mt-1"></span>
                </div>
            </div>

            <!-- Monto y Moneda -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                    <label asp-for="Monto" class="block text-sm font-semibold text-slate-700 dark:text-slate-300 mb-2">
                        <i class="fa fa-dollar-sign mr-2 text-primary-500"></i>Monto a Transferir
                    </label>
                    <input asp-for="Monto" 
                           type="number" 
                           step="0.01" 
                           class="w-full px-4 py-3 border-2 border-slate-200 dark:border-slate-600 rounded-xl bg-white dark:bg-slate-700 text-slate-800 dark:text-slate-200 text-2xl font-bold focus:border-primary-500 focus:ring-4 focus:ring-primary-100 transition outline-none" 
                           placeholder="0.00"
                           required />
                    <span asp-validation-for="Monto" class="text-red-600 text-sm mt-1"></span>
                </div>

                <div>
                    <label asp-for="MonedaTransferencia" class="block text-sm font-semibold text-slate-700 dark:text-slate-300 mb-2">
                        <i class="fa fa-coins mr-2 text-primary-500"></i>Moneda
                    </label>
                    <select asp-for="MonedaTransferencia" 
                            class="w-full px-4 py-3 border-2 border-slate-200 dark:border-slate-600 rounded-xl bg-white dark:bg-slate-700 text-slate-800 dark:text-slate-200 text-lg font-semibold focus:border-primary-500 focus:ring-4 focus:ring-primary-100 transition outline-none" 
                            asp-items="Html.GetEnumSelectList<Moneda>()">
                    </select>
                </div>
            </div>

            <!-- Fecha y Descripción -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                    <label asp-for="Fecha" class="block text-sm font-semibold text-slate-700 dark:text-slate-300 mb-2">
                        <i class="fa fa-calendar mr-2 text-primary-500"></i>Fecha
                    </label>
                    <input asp-for="Fecha" 
                           type="date" 
                           class="w-full px-4 py-3 border-2 border-slate-200 dark:border-slate-600 rounded-xl bg-white dark:bg-slate-700 text-slate-800 dark:text-slate-200 focus:border-primary-500 focus:ring-4 focus:ring-primary-100 transition outline-none" 
                           required />
                    <span asp-validation-for="Fecha" class="text-red-600 text-sm mt-1"></span>
                </div>

                <div>
                    <label asp-for="Descripcion" class="block text-sm font-semibold text-slate-700 dark:text-slate-300 mb-2">
                        <i class="fa fa-comment mr-2 text-primary-500"></i>Motivo (Opcional)
                    </label>
                    <input asp-for="Descripcion" 
                           class="w-full px-4 py-3 border-2 border-slate-200 dark:border-slate-600 rounded-xl bg-white dark:bg-slate-700 text-slate-800 dark:text-slate-200 focus:border-primary-500 focus:ring-4 focus:ring-primary-100 transition outline-none" 
                           placeholder="Ej: Pago de tarjeta..." />
                </div>
            </div>

            <!-- Submit Buttons -->
            <div class="pt-4 border-t border-slate-200 dark:border-slate-700 flex flex-col sm:flex-row gap-3">
                <button type="submit" 
                        class="flex-1 py-3.5 bg-gradient-to-r from-primary-500 to-blue-600 text-white font-bold rounded-xl hover:from-primary-600 hover:to-blue-700 transform hover:scale-[1.02] transition shadow-lg hover:shadow-xl flex items-center justify-center gap-2">
                    <i class="fa fa-exchange"></i>
                    Efectuar Transferencia
                </button>
                <a asp-action="Index" asp-controller="Home" 
                   class="flex-1 sm:flex-initial px-6 py-3.5 bg-slate-200 dark:bg-slate-700 text-slate-700 dark:text-slate-300 font-semibold rounded-xl hover:bg-slate-300 dark:hover:bg-slate-600 transition text-center flex items-center justify-center gap-2">
                    <i class="fa fa-times"></i>
                    Cancelar
                </a>
            </div>
        </form>
    </div>

    <!-- Info Section -->
    <div class="mt-6 bg-purple-50 dark:bg-purple-900/20 border-l-4 border-purple-500 rounded-lg p-6">
        <div class="flex items-start gap-4">
            <div class="text-3xl">💡</div>
            <div class="flex-1">
                <h4 class="text-lg font-bold text-purple-900 dark:text-purple-300 mb-2">Importante sobre Transferencias</h4>
                <ul class="list-disc list-inside text-purple-800 dark:text-purple-200 text-sm space-y-1">
                    <li>El dinero se restará automáticamente de la cuenta origen</li>
                    <li>El mismo monto se sumará a la cuenta destino</li>
                    <li>No afecta tu presupuesto (no es ingreso ni gasto)</li>
                    <li>Ideal para pagar tarjetas de crédito o mover entre cuentas</li>
                </ul>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}