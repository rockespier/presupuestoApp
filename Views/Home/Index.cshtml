@model PresupuestoFamiliarApp.ViewModels.DashboardViewModel

@{
    ViewData["Title"] = "Panel Principal";

    // Un truco rápido para mostrar el nombre del mes seleccionado bonito
    var fechaSeleccionada = new DateTime(Model.AnioSeleccionado, Model.MesSeleccionado, 1);
    string mesFormateado = fechaSeleccionada.ToString("MMMM yyyy");
    // Ponemos la primera letra en mayúscula
    mesFormateado = char.ToUpper(mesFormateado[0]) + mesFormateado.Substring(1);
}

<div class="text-center mb-5">
    <h1 class="display-5 fw-bold text-primary">Mi Presupuesto</h1>

    <form asp-action="Index" method="get" class="d-flex justify-content-center align-items-center gap-2 mt-3 p-3 bg-light rounded-pill shadow-sm mx-auto" style="max-width: 600px;">
        <label class="fw-bold ms-3">Ver periodo:</label>

        <select name="mes" asp-for="MesSeleccionado" class="form-select w-auto border-primary">
            <option value="1">Enero</option>
            <option value="2">Febrero</option>
            <option value="3">Marzo</option>
            <option value="4">Abril</option>
            <option value="5">Mayo</option>
            <option value="6">Junio</option>
            <option value="7">Julio</option>
            <option value="8">Agosto</option>
            <option value="9">Septiembre</option>
            <option value="10">Octubre</option>
            <option value="11">Noviembre</option>
            <option value="12">Diciembre</option>
        </select>

        <select name="anio" asp-for="AnioSeleccionado" class="form-select w-auto border-primary">
            @* Generamos los años dinámicamente: desde 2 años atrás hasta 1 año en el futuro *@
            @for (int i = DateTime.Now.Year - 2; i <= DateTime.Now.Year + 1; i++)
            {
                <option value="@i">@i</option>
            }
        </select>

        <button type="submit" class="btn btn-primary rounded-pill px-4 me-2">Buscar</button>
    </form>

    <p class="lead mt-3 text-muted">Resumen financiero de <strong class="text-dark">@mesFormateado</strong></p>
</div>

<div class="row mb-4">
    <div class="col-md-6">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-body">
                <h5 class="card-title fw-bold text-muted">Distribución de Gastos</h5>
                <div style="height: 300px; display: flex; justify-content: center;">
                    <canvas id="pieChart"></canvas>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-body">
                <h5 class="card-title fw-bold text-muted">Balance Mensual (@Model.AnioSeleccionado)</h5>
                <div style="height: 300px;">
                    <canvas id="barChart"></canvas>
                </div>
            </div>
        </div>
    </div>
</div>

<h3 class="mb-3">Saldos Actuales</h3>
<div class="row mb-4">
    <div class="col-md-8">
        <h3 class="mb-3 text-success">Dinero Disponible</h3>
        <div class="row">
            @foreach (var cuenta in Model.CuentasDinero)
            {
                // Calculamos el símbolo de ESTA cuenta específica
                string simboloCuenta = cuenta.MonedaCuenta == Moneda.Dolares ? "$" : (cuenta.MonedaCuenta == Moneda.Euros ? "€" : "S/");

                <div class="col-md-6 mb-3">
                    <div class="card shadow-sm border-0 border-start border-success border-4 bg-light">
                        <div class="card-body">
                            <h5 class="card-title text-muted">@cuenta.Nombre</h5>
                            <h3 class="fw-bold">@simboloCuenta @cuenta.SaldoActual.ToString("N2")</h3>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>

    <div class="col-md-4">
        <h3 class="mb-3 text-danger">Tarjetas de Credito</h3>
        @foreach (var tarjeta in Model.TarjetasCredito)
        {
            string simboloCuenta = tarjeta.MonedaCuenta == Moneda.Dolares ? "$" : (tarjeta.MonedaCuenta == Moneda.Euros ? "€" : "S/");

            <div class="card shadow-sm border-0 border-start border-danger border-4 bg-light mb-3">
                <div class="card-body">
                    <h5 class="card-title text-muted">@tarjeta.Nombre</h5>
                    <h3 class="fw-bold text-danger">@simboloCuenta @((tarjeta.SaldoActual * -1).ToString("N2"))</h3>

                    <a asp-controller="Transferencias" asp-action="Create" asp-route-destinoId="@tarjeta.Id" class="btn btn-sm btn-outline-danger mt-2 w-100 fw-bold">💳 Pagar Tarjeta</a>
                </div>
            </div>
        }
        
    </div>
</div>

<hr class="my-4" />

<h3 class="mb-3">Flujo de Caja del Mes</h3>
<div class="row mb-4 text-center">
    <div class="col-md-4">
        <div class="card text-white bg-success mb-3 shadow-sm">
            <div class="card-body">
                <h5 class="card-title">Ingresos Totales</h5>
                <h3>+ @Model.SimboloMonedaEspacio @Model.TotalIngresosMes.ToString("N2")</h3>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card text-white bg-danger mb-3 shadow-sm">
            <div class="card-body">
                <h5 class="card-title">Gastos Totales</h5>
                <h3>- @Model.SimboloMonedaEspacio @Model.TotalEgresosMes.ToString("N2")</h3>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card text-white bg-primary mb-3 shadow-sm">
            <div class="card-body">
                <h5 class="card-title">Ahorro del Mes</h5>
                <h3>@Model.SimboloMonedaEspacio @Model.AhorroMes.ToString("N2")</h3>
            </div>
        </div>
    </div>
</div>

<hr class="my-4" />

<h3 class="mb-3">Detalle por Categoría</h3>
<div class="row">
    @foreach (var cat in Model.ResumenCategorias)
    {
        // Lógica para cambiar el color de la barra si nos pasamos del presupuesto
        string barraColor = cat.PorcentajeConsumido >= 100 ? "bg-danger" :
        cat.PorcentajeConsumido > 80 ? "bg-warning" : "bg-success";

        <div class="col-md-6 mb-4">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between mb-1">
                        <span class="fw-bold">@cat.Nombre</span>
                        <span>@Model.SimboloMonedaEspacio @cat.GastoReal.ToString("N2") de € @cat.PresupuestoMensual.ToString("N2")</span>
                    </div>
                    <div class="progress" style="height: 20px;">
                        <div class="progress-bar @barraColor" role="progressbar"
                             style="width: @cat.PorcentajeConsumido%;"
                             aria-valuenow="@cat.PorcentajeConsumido" aria-valuemin="0" aria-valuemax="100">
                            @cat.PorcentajeConsumido%
                        </div>
                    </div>
                    @if (cat.GastoReal > cat.PresupuestoMensual)
                    {
                        <small class="text-danger mt-2 d-block">¡Te has pasado del presupuesto por @Model.SimboloMonedaEspacio @((cat.GastoReal - cat.PresupuestoMensual).ToString("N2"))!</small>
                    }
                </div>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <script>
        // --- 1. GRÁFICO CIRCULAR (GASTOS POR CATEGORÍA) ---
        // Extraemos solo las categorías donde realmente gastaste dinero
        var catLabels = @Html.Raw(Json.Serialize(Model.ResumenCategorias.Where(c => c.GastoReal > 0).Select(c => c.Nombre)));
        var catData = @Html.Raw(Json.Serialize(Model.ResumenCategorias.Where(c => c.GastoReal > 0).Select(c => c.GastoReal)));

        var ctxPie = document.getElementById('pieChart').getContext('2d');
        new Chart(ctxPie, {
            type: 'doughnut', // 'doughnut' queda más moderno que 'pie', pero puedes cambiarlo a 'pie'
            data: {
                labels: catLabels,
                datasets: [{
                    data: catData,
                    // Colores vibrantes para las categorías
                    backgroundColor: ['#FF6384', '#36A2EB', '#FFCE56', '#4BC0C0', '#9966FF', '#FF9F40', '#E7E9ED', '#71B37C'],
                    borderWidth: 1
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { position: 'right' }
                }
            }
        });

        // --- 2. GRÁFICO DE BARRAS (BALANCE ANUAL) ---
        var barLabels = @Html.Raw(Json.Serialize(Model.BalancesHistoricos.Select(b => b.MesNombre)));
        var barData = @Html.Raw(Json.Serialize(Model.BalancesHistoricos.Select(b => b.Balance)));

        // Creamos un arreglo de colores: Verde si el balance es positivo, Rojo si es negativo
        var barColors = barData.map(value => value >= 0 ? 'rgba(25, 135, 84, 0.8)' : 'rgba(220, 53, 69, 0.8)');

        var ctxBar = document.getElementById('barChart').getContext('2d');
        new Chart(ctxBar, {
            type: 'bar',
            data: {
                labels: barLabels,
                datasets: [{
                    label: 'Balance Neto',
                    data: barData,
                    backgroundColor: barColors,
                    borderRadius: 4 // Bordes redondeados modernos
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { display: false } // Ocultamos la leyenda porque es obvio
                }
            }
        });
    </script>
}