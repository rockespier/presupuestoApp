@model IEnumerable<TipoCambio>

@{
    ViewData["Title"] = "Tipos de Cambio";
}

<!-- Header -->
<div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 mb-6">
    <div>
        <h2 class="text-3xl font-bold text-slate-800 dark:text-white mb-2">Tasas de Cambio</h2>
        <p class="text-slate-600 dark:text-slate-400">Gestiona los tipos de cambio entre diferentes monedas</p>
    </div>
    <a asp-action="Create" 
       class="inline-flex items-center gap-2 px-5 py-3 bg-gradient-to-r from-primary-500 to-blue-600 text-white font-semibold rounded-xl hover:from-primary-600 hover:to-blue-700 transition shadow-lg hover:shadow-xl">
        <span class="text-xl font-bold">+</span> Actualizar Tasa
    </a>
</div>

<!-- Summary Cards -->
@{
    var totalTasas = Model.Count();
    var tasasActualizadasHoy = Model.Count(t => t.FechaActualizacion.Date == DateTime.Today);
    var tasasAntiguadas = Model.Count(t => t.FechaActualizacion < DateTime.Today.AddDays(-7));
}

<div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-8">
    <div class="bg-gradient-to-br from-primary-500 to-blue-600 rounded-xl shadow-lg p-6 text-white">
        <div class="flex items-center justify-between mb-2">
            <p class="text-sm font-semibold uppercase tracking-wider text-primary-100">Total Tasas</p>
            <span class="text-3xl">💱</span>
        </div>
        <p class="text-4xl font-bold">@totalTasas</p>
        <p class="text-primary-100 text-sm mt-1">Configuradas</p>
    </div>
    
    <div class="bg-gradient-to-br from-green-500 to-emerald-600 rounded-xl shadow-lg p-6 text-white">
        <div class="flex items-center justify-between mb-2">
            <p class="text-sm font-semibold uppercase tracking-wider text-green-100">Actualizadas Hoy</p>
            <span class="text-3xl">✅</span>
        </div>
        <p class="text-4xl font-bold">@tasasActualizadasHoy</p>
        <p class="text-green-100 text-sm mt-1">Al día</p>
    </div>
    
    <div class="bg-gradient-to-br from-amber-500 to-orange-600 rounded-xl shadow-lg p-6 text-white">
        <div class="flex items-center justify-between mb-2">
            <p class="text-sm font-semibold uppercase tracking-wider text-amber-100">Antiguas</p>
            <span class="text-3xl">⚠️</span>
        </div>
        <p class="text-4xl font-bold">@tasasAntiguadas</p>
        <p class="text-amber-100 text-sm mt-1">+7 días</p>
    </div>
</div>

<!-- Exchange Rates Table -->
@if (Model.Any())
{
    <div class="bg-white dark:bg-slate-800 rounded-xl shadow-lg border border-slate-200 dark:border-slate-700 overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full">
                <thead class="bg-slate-800 dark:bg-slate-900 text-white">
                    <tr>
                        <th class="px-4 py-3 text-left text-sm font-semibold">De (Origen)</th>
                        <th class="px-4 py-3 text-center text-sm font-semibold">→</th>
                        <th class="px-4 py-3 text-left text-sm font-semibold">A (Destino)</th>
                        <th class="px-4 py-3 text-right text-sm font-semibold">Tasa de Conversión</th>
                        <th class="px-4 py-3 text-center text-sm font-semibold">Última Actualización</th>
                        <th class="px-4 py-3 text-center text-sm font-semibold">Acción</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-200 dark:divide-slate-700">
                    @foreach (var item in Model.OrderBy(t => t.MonedaOrigen))
                    {
                        var diasDesdeActualizacion = (DateTime.Now - item.FechaActualizacion).Days;
                        var estadoClase = diasDesdeActualizacion == 0 ? "bg-green-100 dark:bg-green-900/30 text-green-700 dark:text-green-300" :
                                         diasDesdeActualizacion <= 3 ? "bg-blue-100 dark:bg-blue-900/30 text-blue-700 dark:text-blue-300" :
                                         diasDesdeActualizacion <= 7 ? "bg-amber-100 dark:bg-amber-900/30 text-amber-700 dark:text-amber-300" :
                                         "bg-red-100 dark:bg-red-900/30 text-red-700 dark:text-red-300";
                        
                        var iconoOrigen = item.MonedaOrigen == Moneda.Dolares ? "💵" : 
                                         item.MonedaOrigen == Moneda.Euros ? "🇪🇺" : "🇵🇪";
                        var iconoDestino = item.MonedaDestino == Moneda.Dolares ? "💵" : 
                                          item.MonedaDestino == Moneda.Euros ? "🇪🇺" : "🇵🇪";
                        
                        <tr class="hover:bg-slate-50 dark:hover:bg-slate-700/50 transition">
                            <td class="px-4 py-4">
                                <div class="flex items-center gap-2">
                                    <span class="text-2xl">@iconoOrigen</span>
                                    <span class="font-bold text-slate-800 dark:text-white">@item.MonedaOrigen</span>
                                </div>
                            </td>
                            <td class="px-4 py-4 text-center">
                                <span class="text-2xl text-primary-500">→</span>
                            </td>
                            <td class="px-4 py-4">
                                <div class="flex items-center gap-2">
                                    <span class="text-2xl">@iconoDestino</span>
                                    <span class="font-bold text-slate-800 dark:text-white">@item.MonedaDestino</span>
                                </div>
                            </td>
                            <td class="px-4 py-4 text-right">
                                <div class="inline-flex items-center gap-2 px-4 py-2 bg-primary-50 dark:bg-primary-900/30 rounded-lg">
                                    <span class="text-2xl font-bold text-primary-600 dark:text-primary-400">
                                        @item.Tasa.ToString("N4")
                                    </span>
                                </div>
                            </td>
                            <td class="px-4 py-4 text-center">
                                <div class="flex flex-col items-center">
                                    <span class="inline-flex px-3 py-1 text-xs font-semibold rounded-full @estadoClase mb-1">
                                        @item.FechaActualizacion.ToString("dd/MM/yyyy")
                                    </span>
                                    <span class="text-xs text-slate-500 dark:text-slate-400">
                                        @item.FechaActualizacion.ToString("HH:mm")
                                    </span>
                                </div>
                            </td>
                            <td class="px-4 py-4 text-center">
                                <a asp-action="Delete" asp-route-id="@item.Id" 
                                   onclick="return confirm('¿Seguro que deseas eliminar esta tasa de cambio?');"
                                   class="inline-flex px-3 py-1.5 text-xs font-semibold bg-red-100 dark:bg-red-900/30 text-red-700 dark:text-red-300 rounded-lg hover:bg-red-200 dark:hover:bg-red-900/50 transition">
                                    <i class="fa fa-trash mr-1"></i>Eliminar
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
else
{
    <!-- Empty State -->
    <div class="bg-slate-100 dark:bg-slate-800 rounded-xl p-12 text-center">
        <div class="text-6xl mb-4">💱</div>
        <h3 class="text-2xl font-bold text-slate-800 dark:text-white mb-2">No hay tasas de cambio registradas</h3>
        <p class="text-slate-600 dark:text-slate-400 mb-6">
            Configura las tasas de cambio para realizar conversiones automáticas entre monedas
        </p>
        <a asp-action="Create" 
           class="inline-flex items-center gap-2 px-6 py-3 bg-gradient-to-r from-primary-500 to-blue-600 text-white font-semibold rounded-xl hover:from-primary-600 hover:to-blue-700 transition shadow-lg">
            <span class="text-xl font-bold">+</span> Crear Primera Tasa
        </a>
    </div>
}

<!-- Info Section -->
<div class="mt-8 bg-blue-50 dark:bg-blue-900/20 border-l-4 border-blue-500 rounded-lg p-6">
    <div class="flex items-start gap-4">
        <div class="text-3xl">💡</div>
        <div class="flex-1">
            <h4 class="text-lg font-bold text-blue-900 dark:text-blue-300 mb-2">¿Para qué sirven los Tipos de Cambio?</h4>
            <p class="text-blue-800 dark:text-blue-200 text-sm mb-3">
                Los tipos de cambio permiten que el sistema convierta automáticamente entre diferentes monedas 
                cuando realizas transacciones o transferencias.
            </p>
            <ul class="list-disc list-inside text-blue-800 dark:text-blue-200 text-sm space-y-1">
                <li><strong>Transferencias multimoneda:</strong> Convierte automáticamente entre cuentas con diferentes monedas</li>
                <li><strong>Reportes consolidados:</strong> Muestra todos los montos en la moneda principal del espacio</li>
                <li><strong>Actualización manual:</strong> Puedes actualizar las tasas cuando cambien</li>
                <li><strong>Ejemplo:</strong> Si 1 USD = 3.75 PEN, registra esa tasa para conversiones automáticas</li>
            </ul>
        </div>
    </div>
</div>