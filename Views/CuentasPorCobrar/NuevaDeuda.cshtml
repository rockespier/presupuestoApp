@model PresupuestoFamiliarApp.Models.CuentaPorCobrar

@{
    ViewData["Title"] = "Nueva Deuda";
}

<!-- Header -->
<div class="mb-6">
    <h2 class="text-3xl font-bold text-slate-800 dark:text-white mb-2 flex items-center gap-2">
        <span class="text-red-500">💸</span> Cargar Nueva Deuda
    </h2>
    <p class="text-slate-600 dark:text-slate-400">Registra un nuevo cargo o alquiler para este deudor</p>
</div>

<div class="max-w-xl mx-auto">
    <div class="bg-white dark:bg-slate-800 rounded-xl shadow-lg border border-slate-200 dark:border-slate-700 p-6 lg:p-8">
        <form asp-action="NuevaDeuda" class="space-y-6">
            <input type="hidden" asp-for="DeudorId" value="@ViewBag.DeudorId" />
            
            <!-- Validation Summary -->
            <div asp-validation-summary="All" class="bg-red-50 dark:bg-red-900/20 border-l-4 border-red-500 rounded-lg p-4" role="alert">
                <div class="flex items-center gap-2 text-red-700 dark:text-red-400">
                    <i class="fa fa-exclamation-circle"></i>
                    <span class="font-semibold">Por favor corrige los siguientes errores:</span>
                </div>
            </div>

            <!-- Concepto -->
            <div>
                <label asp-for="Concepto" class="block text-sm font-semibold text-slate-700 dark:text-slate-300 mb-2">
                    <i class="fa fa-file-text mr-2 text-primary-500"></i>Concepto
                </label>
                <input asp-for="Concepto" 
                       class="w-full px-4 py-3 border-2 border-slate-200 dark:border-slate-600 rounded-xl bg-white dark:bg-slate-700 text-slate-800 dark:text-slate-200 focus:border-primary-500 focus:ring-4 focus:ring-primary-100 transition outline-none" 
                       placeholder="Ej: Alquiler Enero 2026, Préstamo..." 
                       required />
                <span asp-validation-for="Concepto" class="text-red-600 text-sm mt-1"></span>
            </div>

            <!-- Moneda -->
            <div>
                <label asp-for="MonedaDeuda" class="block text-sm font-semibold text-slate-700 dark:text-slate-300 mb-2">
                    <i class="fa fa-coins mr-2 text-primary-500"></i>Moneda
                </label>
                <select asp-for="MonedaDeuda" 
                        class="w-full px-4 py-3 border-2 border-slate-200 dark:border-slate-600 rounded-xl bg-white dark:bg-slate-700 text-slate-800 dark:text-slate-200 focus:border-primary-500 focus:ring-4 focus:ring-primary-100 transition outline-none" 
                        asp-items="Html.GetEnumSelectList<Moneda>()">
                </select>
                <p class="text-xs text-slate-500 dark:text-slate-400 mt-1 flex items-center gap-1">
                    <i class="fa fa-info-circle"></i>
                    Selecciona la moneda en la que se pactó la deuda
                </p>
            </div>

            <!-- Monto Total -->
            <div>
                <label asp-for="MontoTotal" class="block text-sm font-semibold text-slate-700 dark:text-slate-300 mb-2">
                    <i class="fa fa-dollar-sign mr-2 text-primary-500"></i>Monto Total
                </label>
                <div class="flex items-center gap-2">
                    <span id="simboloMoneda" class="px-4 py-3 bg-slate-100 dark:bg-slate-700 text-slate-700 dark:text-slate-300 font-bold rounded-lg border-2 border-slate-200 dark:border-slate-600">
                        @ViewBag.SimboloMoneda
                    </span>
                    <input asp-for="MontoTotal" 
                           type="number" 
                           step="0.01" 
                           class="flex-1 px-4 py-3 border-2 border-slate-200 dark:border-slate-600 rounded-xl bg-white dark:bg-slate-700 text-slate-800 dark:text-slate-200 text-2xl font-bold focus:border-primary-500 focus:ring-4 focus:ring-primary-100 transition outline-none" 
                           placeholder="0.00"
                           required />
                </div>
                <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">El símbolo cambiará según la moneda seleccionada</p>
                <span asp-validation-for="MontoTotal" class="text-red-600 text-sm mt-1"></span>
            </div>

            <!-- Fecha de Vencimiento -->
            <div>
                <label asp-for="FechaVencimiento" class="block text-sm font-semibold text-slate-700 dark:text-slate-300 mb-2">
                    <i class="fa fa-calendar mr-2 text-primary-500"></i>Fecha de Vencimiento
                </label>
                <input asp-for="FechaVencimiento" 
                       type="date" 
                       class="w-full px-4 py-3 border-2 border-slate-200 dark:border-slate-600 rounded-xl bg-white dark:bg-slate-700 text-slate-800 dark:text-slate-200 focus:border-primary-500 focus:ring-4 focus:ring-primary-100 transition outline-none" 
                       required />
                <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">Fecha límite de pago</p>
                <span asp-validation-for="FechaVencimiento" class="text-red-600 text-sm mt-1"></span>
            </div>

            <!-- Es Alquiler Checkbox -->
            <div class="bg-purple-50 dark:bg-purple-900/20 border-2 border-purple-200 dark:border-purple-800 rounded-xl p-4">
                <label class="flex items-start cursor-pointer">
                    <input type="checkbox" asp-for="EsAlquiler" class="w-5 h-5 text-purple-600 rounded focus:ring-purple-500 mt-0.5" />
                    <span class="ml-3">
                        <span class="block text-sm font-semibold text-purple-900 dark:text-purple-300">
                            <i class="fa fa-home mr-1"></i>Es un alquiler mensual recurrente
                        </span>
                        <span class="block text-xs text-purple-700 dark:text-purple-400 mt-1">
                            Marcalo si este cargo se repite todos los meses (como un alquiler)
                        </span>
                    </span>
                </label>
            </div>

            <!-- Submit Buttons -->
            <div class="pt-4 border-t border-slate-200 dark:border-slate-700 flex flex-col sm:flex-row gap-3">
                <button type="submit" 
                        class="flex-1 py-3.5 bg-gradient-to-r from-red-500 to-rose-600 text-white font-bold rounded-xl hover:from-red-600 hover:to-rose-700 transform hover:scale-[1.02] transition shadow-lg hover:shadow-xl flex items-center justify-center gap-2">
                    <i class="fa fa-save"></i>
                    Guardar Deuda
                </button>
                <a asp-action="Detalle" asp-route-id="@ViewBag.DeudorId" 
                   class="flex-1 sm:flex-initial px-6 py-3.5 bg-slate-200 dark:bg-slate-700 text-slate-700 dark:text-slate-300 font-semibold rounded-xl hover:bg-slate-300 dark:hover:bg-slate-600 transition text-center flex items-center justify-center gap-2">
                    <i class="fa fa-times"></i>
                    Cancelar
                </a>
            </div>
        </form>
    </div>

    <!-- Info Section -->
    <div class="mt-6 bg-blue-50 dark:bg-blue-900/20 border-l-4 border-blue-500 rounded-lg p-6">
        <div class="flex items-start gap-4">
            <div class="text-3xl">💡</div>
            <div class="flex-1">
                <h4 class="text-lg font-bold text-blue-900 dark:text-blue-300 mb-2">Consejos sobre Deudas</h4>
                <ul class="list-disc list-inside text-blue-800 dark:text-blue-200 text-sm space-y-1">
                    <li><strong>Alquileres:</strong> Marca la casilla "Es alquiler" para cargos mensuales regulares</li>
                    <li><strong>Fecha de vencimiento:</strong> Te ayudará a identificar pagos atrasados</li>
                    <li>Puedes registrar pagos parciales si el deudor paga por partes</li>
                    <li>Una vez pagada, la deuda quedará marcada como completada</li>
                </ul>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        // Actualizar el símbolo de moneda dinámicamente
        document.querySelector('select[name="MonedaDeuda"]').addEventListener('change', function() {
            const moneda = this.value;
            let simbolo = 'S/';
            if (moneda === '1') simbolo = '$';
            else if (moneda === '2') simbolo = '€';
            document.getElementById('simboloMoneda').textContent = simbolo;
        });
    </script>
}