@model Cuenta
<h2>Configurar Cuenta</h2>
<hr />
<form asp-action="@(Model?.Id > 0 ? "Edit" : "Create")">
    <input type="hidden" asp-for="Id" />
    <div class="form-group mb-3">
        <label asp-for="Nombre" class="control-label fw-bold"></label>
        <input asp-for="Nombre" class="form-control" required />
    </div>
    <div class="form-group mb-3">
        <label asp-for="SaldoActual" class="control-label fw-bold">Saldo Inicial / Deuda Actual</label>
        <input asp-for="SaldoActual" type="number" step="0.01" class="form-control" required />
    </div>
    <div class="form-check mb-4">
        <input asp-for="EsCredito" class="form-check-input" type="checkbox" />
        <label asp-for="EsCredito" class="form-check-label text-danger fw-bold">Es una Tarjeta de Crédito</label>
    </div>
    <button type="submit" class="btn btn-success">Guardar</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>