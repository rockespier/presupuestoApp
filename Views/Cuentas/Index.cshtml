@model IEnumerable<Cuenta>
<h2>Mis Cuentas y Tarjetas</h2>
<a asp-action="Create" class="btn btn-primary mb-3">+ Nueva Cuenta</a>
<table class="table table-striped">
    <thead class="table-dark">
        <tr><th>Nombre</th><th>Saldo / Deuda</th><th>Tipo</th><th>Acciones</th></tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Nombre</td>
                <td class="fw-bold @(item.EsCredito ? "text-danger" : "text-success")">
                    @item.MonedaCuenta @item.SaldoActual.ToString("N2")
                </td>
                <td>@(item.EsCredito ? "💳 Tarjeta de Crédito" : "💵 Cuenta de Dinero")</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Editar</a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Eliminar</a>
                </td>
            </tr>
        }
    </tbody>
</table>