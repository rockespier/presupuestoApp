@model CategoriaGasto

@{
    ViewData["Title"] = "Nueva Categoría";
    var monedaPorDefecto = ViewBag.MonedaPorDefecto ?? Moneda.Soles;
}

<!-- Header -->
<div class="mb-6">
    <h2 class="text-3xl font-bold text-slate-800 dark:text-white mb-2">Nueva Categoría de Presupuesto</h2>
    <p class="text-slate-600 dark:text-slate-400">Crea una nueva categoría para organizar y controlar tus gastos mensuales</p>
</div>

<div class="max-w-2xl">
    <div class="bg-white dark:bg-slate-800 rounded-xl shadow-lg border border-slate-200 dark:border-slate-700 p-6 lg:p-8">
        <form asp-action="Create" class="space-y-6">
            <!-- Validation Summary -->
            <div asp-validation-summary="ModelOnly" class="bg-red-50 dark:bg-red-900/20 border-l-4 border-red-500 rounded-lg p-4 mb-6" role="alert">
                <div class="flex items-center gap-2 text-red-700 dark:text-red-400">
                    <i class="fa fa-exclamation-circle"></i>
                    <span class="font-semibold">Por favor corrige los siguientes errores:</span>
                </div>
            </div>

            <!-- Nombre -->
            <div>
                <label asp-for="Nombre" class="block text-sm font-semibold text-slate-700 dark:text-slate-300 mb-2">
                    <i class="fa fa-tag mr-2 text-primary-500"></i>Nombre de la Categoría
                </label>
                <input asp-for="Nombre" 
                       class="w-full px-4 py-3 border-2 border-slate-200 dark:border-slate-600 rounded-xl bg-white dark:bg-slate-700 text-slate-800 dark:text-slate-200 focus:border-primary-500 focus:ring-4 focus:ring-primary-100 transition outline-none" 
                       placeholder="Ej. Educación, Salud, Entretenimiento..." 
                       required />
                <span asp-validation-for="Nombre" class="text-red-600 text-sm mt-1"></span>
            </div>

            <!-- Subcategoría -->
            <div>
                <label asp-for="Subcategoria" class="block text-sm font-semibold text-slate-700 dark:text-slate-300 mb-2">
                    <i class="fa fa-tags mr-2 text-primary-500"></i>Subcategorías (Opcional)
                </label>
                <input asp-for="Subcategoria" 
                       class="w-full px-4 py-3 border-2 border-slate-200 dark:border-slate-600 rounded-xl bg-white dark:bg-slate-700 text-slate-800 dark:text-slate-200 focus:border-primary-500 focus:ring-4 focus:ring-primary-100 transition outline-none" 
                       placeholder="Ej. Uniformes, Libros, Transporte..." />
                <p class="text-xs text-slate-500 dark:text-slate-400 mt-1 flex items-center gap-1">
                    ⬤
                    Agrega detalles opcionales para mayor organización
                </p>
            </div>

            <!-- Moneda -->
            <div>
                <label asp-for="MonedaCategoria" class="block text-sm font-semibold text-slate-700 dark:text-slate-300 mb-3">
                    <i class="fa fa-coins mr-2 text-primary-500"></i>Moneda del Presupuesto
                </label>
                
                <div class="space-y-3">
                    @{
                        var monedas = new[] { 
                            new { Value = "0", Label = "Soles Peruanos", Symbol = "🇵🇪 S/", Code = "PEN" },
                            new { Value = "1", Label = "Dólares Americanos", Symbol = "💵 $", Code = "USD" },
                            new { Value = "2", Label = "Euros", Symbol = "🇪🇺 €", Code = "EUR" }
                        };
                        
                        foreach (var moneda in monedas)
                        {
                            var isSelected = (moneda.Value == "0" && monedaPorDefecto == Moneda.Soles) ||
                                           (moneda.Value == "1" && monedaPorDefecto == Moneda.Dolares) ||
                                           (moneda.Value == "2" && monedaPorDefecto == Moneda.Euros);
                            
                            <label class="flex items-center p-4 border-2 @(isSelected ? "border-primary-500 bg-primary-50 dark:bg-primary-900/20" : "border-slate-200 dark:border-slate-700") rounded-xl cursor-pointer hover:border-primary-400 transition">
                                <input type="radio" name="MonedaCategoria" value="@moneda.Value" 
                                       class="w-5 h-5 text-primary-600 focus:ring-primary-500 moneda-radio" 
                                       @(isSelected ? "checked" : "") />
                                <div class="ml-4 flex items-center gap-3 flex-1">
                                    <span class="text-2xl">@Html.Raw(moneda.Symbol.Split(' ')[0])</span>
                                    <div>
                                        <p class="font-bold text-slate-800 dark:text-white">@moneda.Label</p>
                                        <p class="text-sm text-slate-600 dark:text-slate-400">@moneda.Symbol.Split(' ')[1] - @moneda.Code</p>
                                    </div>
                                </div>
                            </label>
                        }
                    }
                </div>
                
                <p class="text-xs text-slate-500 dark:text-slate-400 mt-2 flex items-center gap-1">
                    ⬤
                    Selecciona la moneda en la que establecerás el presupuesto mensual
                </p>
            </div>

            <!-- Presupuesto Mensual -->
            <div>
                <label asp-for="PresupuestoMensual" class="block text-sm font-semibold text-slate-700 dark:text-slate-300 mb-2">
                    <i class="fa fa-dollar-sign mr-2 text-primary-500"></i>Presupuesto Mensual Asignado
                </label>
                <div class="flex items-center gap-2">
                    <span id="simboloMoneda" class="px-4 py-3 bg-slate-100 dark:bg-slate-700 text-slate-700 dark:text-slate-300 font-bold rounded-lg border-2 border-slate-200 dark:border-slate-600">
                        @ViewBag.SimboloMoneda
                    </span>
                    <input asp-for="PresupuestoMensual" 
                           type="number" 
                           step="0.01" 
                           class="flex-1 px-4 py-3 border-2 border-slate-200 dark:border-slate-600 rounded-xl bg-white dark:bg-slate-700 text-slate-800 dark:text-slate-200 text-2xl font-bold focus:border-primary-500 focus:ring-4 focus:ring-primary-100 transition outline-none" 
                           placeholder="0.00"
                           required />
                </div>
                <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">El símbolo cambiará automáticamente según la moneda seleccionada</p>
                <span asp-validation-for="PresupuestoMensual" class="text-red-600 text-sm mt-1"></span>
            </div>

            <!-- Submit Buttons -->
            <div class="pt-4 border-t border-slate-200 dark:border-slate-700 flex flex-col sm:flex-row gap-3">
                <button type="submit" 
                        class="flex-1 py-3.5 bg-gradient-to-r from-green-500 to-emerald-600 text-white font-bold rounded-xl hover:from-green-600 hover:to-emerald-700 transform hover:scale-[1.02] transition shadow-lg hover:shadow-xl flex items-center justify-center gap-2">
                    <i class="fa fa-save"></i>
                    Crear Categoría
                </button>
                <a asp-action="Index" 
                   class="flex-1 sm:flex-initial px-6 py-3.5 bg-slate-200 dark:bg-slate-700 text-slate-700 dark:text-slate-300 font-semibold rounded-xl hover:bg-slate-300 dark:hover:bg-slate-600 transition text-center flex items-center justify-center gap-2">
                    <i class="fa fa-times"></i>
                    Cancelar
                </a>
            </div>
        </form>
    </div>

    <!-- Info Section -->
    <div class="mt-6 bg-blue-50 dark:bg-blue-900/20 border-l-4 border-blue-500 rounded-lg p-6">
        <div class="flex items-start gap-4">
            <div class="text-3xl">💡</div>
            <div class="flex-1">
                <h4 class="text-lg font-bold text-blue-900 dark:text-blue-300 mb-2">Consejos para tus Presupuestos</h4>
                <ul class="list-disc list-inside text-blue-800 dark:text-blue-200 text-sm space-y-1">
                    <li>Asigna presupuestos realistas basados en tus ingresos mensuales</li>
                    <li>Usa subcategorías para mayor detalle (ej. "Educación: Uniformes, Libros")</li>
                    <li>Deja un margen del 10-15% para gastos imprevistos</li>
                    <li>Revisa y ajusta tus presupuestos cada mes según tus necesidades</li>
                </ul>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        // Actualizar el símbolo de moneda dinámicamente
        const radios = document.querySelectorAll('.moneda-radio');
        radios.forEach(radio => {
            radio.addEventListener('change', function() {
                const moneda = this.value;
                let simbolo = 'S/'; // Por defecto Soles

                if (moneda === '1') { // Dolares
                    simbolo = '$';
                } else if (moneda === '2') { // Euros
                    simbolo = '€';
                }

                document.getElementById('simboloMoneda').textContent = simbolo;
            });
        });
    </script>
}