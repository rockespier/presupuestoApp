@model IEnumerable<CategoriaGasto>

@{
    ViewData["Title"] = "Mis Presupuestos";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Gestión de Presupuestos y Categorías</h2>
    <a asp-action="Create" class="btn btn-primary">+ Nueva Categoría</a>
</div>

<div class="row">
    @foreach (var item in Model)
    {
        <div class="col-md-4 mb-4">
            <div class="card shadow-sm h-100 border-start border-primary border-4">
                <div class="card-body">
                    <h5 class="card-title fw-bold">@item.Nombre</h5>
                    <h6 class="card-subtitle mb-2 text-muted">@(item.Subcategoria ?? "Sin subcategorías")</h6>

                    <p class="card-text mt-3">
                        Presupuesto Mensual:<br />
                        <span class="fs-3 fw-bold text-primary">@ViewBag.SimboloMoneda @item.PresupuestoMensual.ToString("N2")</span>
                    </p>

                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-primary w-100">
                        Editar Presupuesto
                    </a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger w-100 mt-2">Eliminar Categoría</a>
                </div>
            </div>
        </div>
    }
</div>